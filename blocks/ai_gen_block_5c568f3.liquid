{% doc %}
  @prompt
    Create a fully interactive frequently asked questions (FAQ) section with a centered heading "Frequently Asked Questions" and 8 collapsible accordion-style question items. Each question must be clickable to toggle open/closed and reveal the answer content below. Include proper JavaScript functionality for expanding/collapsing, smooth CSS transitions, and visual indicators (like arrows or plus/minus icons) to show open/closed states. The questions are: "What if my dog doesn't like the chews?", "At what age can my pup start using these?", "What does 100% Human-Grade mean?", "How long until I start seeing the benefits?", "How many chews come in a jar?", "What flavour is the Multivitamin?", "What happens if I accidentally give my dog too many chews?", and "Can I take this dog multivitamin with other supplements?". Ensure the accordion functionality works with proper click handlers and smooth animations., add padding around the section.
    Also, there's a weird gap above the answer text when the tab is opened, please decrease that

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-faq-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.item_spacing }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.item_background }};
    overflow: hidden;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: {{ block.settings.question_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_color }};
    transition: background-color 0.3s;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_background }};
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 16px;
    color: {{ block.settings.icon_color }};
    transition: transform 0.3s ease;
  }

  .ai-faq-question-{{ ai_gen_id }}[aria-expanded="true"] .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    padding: 0 20px;
    height: 0;
    overflow: hidden;
    opacity: 0;
    transition: height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;
  }

  .ai-faq-answer-inner-{{ ai_gen_id }} {
    padding-bottom: 20px;
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_size }}px;
  }

  .ai-faq-question-{{ ai_gen_id }}[aria-expanded="true"] + .ai-faq-answer-{{ ai_gen_id }} {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size | times: 0.9 }}px;
      padding: 15px;
    }

    .ai-faq-answer-inner-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_size | times: 0.9 }}px;
      padding-bottom: 15px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-faq-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  
  <ul class="ai-faq-list-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% assign question_key = 'question_' | append: i %}
      {% assign answer_key = 'answer_' | append: i %}
      
      {% if block.settings[question_key] != blank and block.settings[answer_key] != blank %}
        <li class="ai-faq-item-{{ ai_gen_id }}">
          <button 
            class="ai-faq-question-{{ ai_gen_id }}" 
            aria-expanded="false" 
            aria-controls="faq-answer-{{ ai_gen_id }}-{{ i }}"
          >
            <span>{{ block.settings[question_key] }}</span>
            <span class="ai-faq-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div id="faq-answer-{{ ai_gen_id }}-{{ i }}" class="ai-faq-answer-{{ ai_gen_id }}">
            <div class="ai-faq-answer-inner-{{ ai_gen_id }}">
              {{ block.settings[answer_key] }}
            </div>
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.accordionItems = this.querySelectorAll('.ai-faq-item-{{ ai_gen_id }}');
        this.questions = this.querySelectorAll('.ai-faq-question-{{ ai_gen_id }}');
        this.answers = this.querySelectorAll('.ai-faq-answer-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.initializeHeights();
      }

      initializeHeights() {
        this.answers.forEach(answer => {
          // Store the actual height for later use
          const answerInner = answer.querySelector('.ai-faq-answer-inner-{{ ai_gen_id }}');
          answer.dataset.height = answerInner.offsetHeight;
        });
      }

      setupEventListeners() {
        this.questions.forEach((question, index) => {
          question.addEventListener('click', () => {
            this.toggleAccordion(index);
          });
        });
      }

      toggleAccordion(index) {
        const question = this.questions[index];
        const answer = this.answers[index];
        const isExpanded = question.getAttribute('aria-expanded') === 'true';

        // If we're opening this one, close all others first
        if (!isExpanded) {
          this.closeAll();
        }

        // Toggle the current item
        question.setAttribute('aria-expanded', !isExpanded);
        
        if (!isExpanded) {
          // Open this answer - no padding top to reduce the gap
          answer.style.height = `${answer.dataset.height}px`;
          answer.style.paddingTop = '0';
        } else {
          // Close this answer
          answer.style.height = '0';
          answer.style.paddingTop = '0';
        }
      }

      closeAll() {
        this.questions.forEach((question, i) => {
          question.setAttribute('aria-expanded', 'false');
          this.answers[i].style.height = '0';
          this.answers[i].style.paddingTop = '0';
        });
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

