{% doc %}
  @prompt
    Create a hero title block with a heading text on the left side and an image on the right side that extends beyond the screen edge (overflow effect). The image should be "cut off" by the screen boundary to create a modern design effect. Make it fully responsive - on mobile the image should still overflow off the right edge, and on desktop it should maintain the same overflow effect but with larger sizing. Include editable text settings for the title and an image upload option. The layout should have the text positioned on the left and the image positioned to extend beyond the right edge of the container. Use proper CSS overflow handling and responsive design., good start, but give me full freedom to resize the image, also height, px specific, starting at 0.
    
    Also add the ability to add background color highlighting behind some specific words in the heading.
    
    The text on mobile needs to be wider, now the image takes up more space.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-title-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ block.settings.section_height }}px;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-hero-title-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;z-index: 2;
  }

  .ai-hero-title-content-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.text_width }}%;
    padding-right: 40px;
  }

  .ai-hero-title-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-hero-title-highlight-{{ ai_gen_id }} {
    background-color: {{ block.settings.highlight_color }};
    color: {{ block.settings.highlight_text_color }};
    padding: {{ block.settings.highlight_padding }}px;
    border-radius: {{ block.settings.highlight_border_radius }}px;}

  .ai-hero-title-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 16px 0 0;
    line-height: 1.4;
  }

  .ai-hero-title-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.image_offset_x }}px;
    top: {{ block.settings.image_offset_y }}px;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    z-index: 1;
  }

  .ai-hero-title-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-title-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;}

  .ai-hero-title-image-placeholder-{{ ai_gen_id }} svg {
    width:100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-title-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
      padding: {{ block.settings.mobile_padding }}px 20px;
    }

    .ai-hero-title-content-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_text_width }}%;
      padding-right: 20px;
    }

    .ai-hero-title-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-hero-title-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtext_size }}px;
    }

    .ai-hero-title-image-wrapper-{{ ai_gen_id }} {
      right: {{ block.settings.mobile_image_offset_x }}px;
      top: {{ block.settings.mobile_image_offset_y }}px;
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-hero-title-highlight-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_highlight_padding }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-title-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-title-container-{{ ai_gen_id }}">
    <div class="ai-hero-title-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-title-heading-{{ ai_gen_id }}">
          {% assign heading_parts = block.settings.heading | split: block.settings.highlight_text %}
          {% if block.settings.highlight_text != blank and block.settings.heading contains block.settings.highlight_text %}
            {% for part in heading_parts %}
              {{ part }}
              {% unless forloop.last %}
                <span class="ai-hero-title-highlight-{{ ai_gen_id }}">{{ block.settings.highlight_text }}</span>
              {% endunless %}
            {% endfor %}
          {% else %}
            {{ block.settings.heading }}
          {% endif %}
        </h1>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <div class="ai-hero-title-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
      {% endif %}
    </div>
  </div>
  <div class="ai-hero-title-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 1200 }}"
        alt="{{ block.settings.image.alt | escape }}"
        class="ai-hero-title-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-hero-title-image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div></div>

