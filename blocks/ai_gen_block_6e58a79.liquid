{% doc %}
  @prompt
    Create a features grid section with 6 items in a 2x3 layout (2 columns, 3 rows) that maintains the same 2x3 grid layout on both desktop and mobile devices. Each feature should have an icon at the top, a heading, and descriptive text below. The features are: 1) Ultrasonic (with sound wave icon) - "Measures the humidity level and uses high-frequency vibrations to create a fine mist", 2) Quiet Operation (with sound bars icon) - "Quiet and energy-efficient, perfect for bedrooms and living rooms", 3) Better Sleep (with moon icon) - "Promote restful sleep by reducing nasal congestion and dryness", 4) Healthy Houseplants (with leaf icon) - "Create a favorable environment for your houseplants to thrive", 5) Feature 5 (with placeholder icon) - "Add your fifth feature description here", 6) Feature 6 (with placeholder icon) - "Add your sixth feature description here". Use clean typography, proper spacing for mobile devices, and make all text content editable through block settings. Include icon upload options for each feature. Keep the 2-column layout on mobile with appropriate sizing and spacing., align the icons and the text on the left.
    Also remove the minimum 10px grid gap, give me full control., mobile looks good now, but please make desktop 3x2 instead of 2x3.
    
    and give me the ability to set a item border width individually for mobile and desktop.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};}

  .ai-features-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-features-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;}

  .ai-feature-item-{{ ai_gen_id }} {
    text-align: left;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 0 {{ block.settings.icon_margin_bottom }}px 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .ai-feature-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.icon_color }};
  }

  .ai-feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;line-height: 1.3;
  }

  .ai-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-features-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-features-grid-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-features-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-feature-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding_mobile }}px;
      border: {{ block.settings.item_border_width_mobile }}px solid {{ block.settings.item_border_color }};
    }

    .ai-feature-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
      margin-bottom: {{ block.settings.icon_margin_bottom_mobile }}px;
    }

    .ai-feature-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-feature-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-features-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-grid-container-{{ ai_gen_id }}">
    <div class="ai-features-grid-wrapper-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign feature_heading_key = 'feature_' | append: i | append: '_heading'
          assign feature_text_key = 'feature_' | append: i | append: '_text'
          assign feature_icon_key = 'feature_' | append: i | append: '_icon'
          
          assign feature_heading = block.settings[feature_heading_key]
          assign feature_text = block.settings[feature_text_key]
          assign feature_icon = block.settings[feature_icon_key]
        %}
        
        <div class="ai-feature-item-{{ ai_gen_id }}">
          <div class="ai-feature-icon-{{ ai_gen_id }}">
            {% if feature_icon %}
              <img
                src="{{ feature_icon | image_url: width: 200}}"
                alt="{{ feature_heading | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              {% case i %}
                {% when 1 %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                  </svg>
                {% when 2 %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="10" width="2" height="4"></rect>
                    <rect x="7" y="6" width="2" height="12"></rect>
                    <rect x="11" y="8" width="2" height="8"></rect>
                    <rect x="15" y="4" width="2" height="16"></rect>
                <rect x="19" y="7" width="2" height="10"></rect>
                  </svg>
                {% when 3 %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                  </svg>
                {% when 4 %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                  </svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  </svg>{% endcase %}
            {% endif %}
          </div>
          
          {% if feature_heading != blank %}
            <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ feature_heading }}</h3>
          {% endif %}
          
          {% if feature_text != blank %}
            <p class="ai-feature-text-{{ ai_gen_id }}">{{ feature_text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

