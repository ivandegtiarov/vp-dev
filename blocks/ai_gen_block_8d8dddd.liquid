{% doc %}
  @prompt
    Create a product collection grid section with the following design: Two-column card layout (mobile-friendly); bold product title; star rating display (5-star style); short product description text; optional promotional badge (e.g. "FREE gift for orders over X"); "From" price with strikethrough original price and highlighted sale price in green; full-width green "Shop Now" CTA button at bottom of each card; cards have light off-white cream background with rounded corners; clean premium health-focused aesthetic
    
    The card layout should be a horizontally scrollable row with overflow visible, so the next card peeks partially into view on the right edge (approximately 20-30px visible), hinting at more content. Cards should have a fixed width (e.g. 75-80% of the viewport) so two cards are never fully visible at once on mobile. No pagination dots or arrows — the peek effect alone signals scrollability.
    
    , price should be accurately loaded from the products in the collection.
    
    the stars should not have a review count next to it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-product-grid-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-grid-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}%;
    min-width: {{ block.settings.card_width }}%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_inner_gap }}px;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-product-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_position_top }}px;
    left: {{ block.settings.badge_position_left }}px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: {{ block.settings.badge_font_weight }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    flex-grow: 1;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-card-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ai-product-card-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-product-card-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-product-card-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-product-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-product-card-price-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_label_font_size }}px;
    color: {{ block.settings.price_label_color }};
    font-weight: {{ block.settings.price_label_font_weight }};
  }

  .ai-product-card-price-values-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-product-card-price-original-{{ ai_gen_id }} {
    font-size: {{ block.settings.original_price_font_size }}px;
    color: {{ block.settings.original_price_color }};
    text-decoration: line-through;
  }

  .ai-product-card-price-sale-{{ ai_gen_id }} {
    font-size: {{ block.settings.sale_price_font_size }}px;
    color: {{ block.settings.sale_price_color }};
    font-weight: {{ block.settings.sale_price_font_weight }};
  }

  .ai-product-card-button-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    cursor: pointer;
    text-decoration: none;
    display: block;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .ai-product-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (min-width: 750px) {
    .ai-product-grid-scroll-{{ ai_gen_id }} {
      gap: {{ block.settings.card_gap_desktop }}px;
    }

    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_desktop }}%;
      min-width: {{ block.settings.card_width_desktop }}%;
    }
  }
{% endstyle %}

<product-collection-grid-{{ ai_gen_id }}
  class="ai-product-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    <div class="ai-product-grid-scroll-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-card-image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                >
              {% else %}
                <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_badge and block.settings.badge_text != blank %}
                <div class="ai-product-card-badge-{{ ai_gen_id }}">
                  {{ block.settings.badge_text }}
                </div>
              {% endif %}
            </div>

            <div class="ai-product-card-content-{{ ai_gen_id }}">
              <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>

              {% if block.settings.show_rating %}
                <div class="ai-product-card-rating-{{ ai_gen_id }}">
                  <div class="ai-product-card-stars-{{ ai_gen_id }}">
                    {% for i in (1..5) %}
                      <svg
                        class="ai-product-card-star-{{ ai_gen_id }} {% if i > block.settings.rating_value %}ai-product-card-star-empty-{{ ai_gen_id }}{% endif %}"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {% if block.settings.show_description and product.description != blank %}
                <p class="ai-product-card-description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: block.settings.description_length }}
                </p>
              {% endif %}

              <div class="ai-product-card-price-{{ ai_gen_id }}">
                {% if block.settings.show_price_label %}
                  <span class="ai-product-card-price-label-{{ ai_gen_id }}">
                    {{ block.settings.price_label_text }}
                  </span>
                {% endif %}
                <div class="ai-product-card-price-values-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-card-price-original-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span class="ai-product-card-price-sale-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                </div>
              </div>

              <a
                href="{{ product.url }}"
                class="ai-product-card-button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-card-image-{{ ai_gen_id }}">
              <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
              {% if block.settings.show_badge and block.settings.badge_text != blank %}
                <div class="ai-product-card-badge-{{ ai_gen_id }}">
                  {{ block.settings.badge_text }}
                </div>
              {% endif %}
            </div>

            <div class="ai-product-card-content-{{ ai_gen_id }}">
              <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                Product Title
              </h3>

              {% if block.settings.show_rating %}
                <div class="ai-product-card-rating-{{ ai_gen_id }}">
                  <div class="ai-product-card-stars-{{ ai_gen_id }}">
                    {% for j in (1..5) %}
                      <svg
                        class="ai-product-card-star-{{ ai_gen_id }} {% if j > block.settings.rating_value %}ai-product-card-star-empty-{{ ai_gen_id }}{% endif %}"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {% if block.settings.show_description %}
                <p class="ai-product-card-description-{{ ai_gen_id }}">
                  A short description of the product highlighting its key benefits and features.
                </p>
              {% endif %}

              <div class="ai-product-card-price-{{ ai_gen_id }}">
                {% if block.settings.show_price_label %}
                  <span class="ai-product-card-price-label-{{ ai_gen_id }}">
                    {{ block.settings.price_label_text }}
                  </span>
                {% endif %}
                <div class="ai-product-card-price-values-{{ ai_gen_id }}">
                  <span class="ai-product-card-price-original-{{ ai_gen_id }}">
                    €49.99
                  </span>
                  <span class="ai-product-card-price-sale-{{ ai_gen_id }}">
                    €39.99
                  </span>
                </div>
              </div>

              <a
                href="#"
                class="ai-product-card-button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</product-collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-product-grid-container-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.container) return;

        let isScrolling = false;
        let startX;
        let scrollLeft;

        this.container.addEventListener('touchstart', (e) => {
          isScrolling = true;
          startX = e.touches[0].pageX - this.container.offsetLeft;
          scrollLeft = this.container.scrollLeft;
        });

        this.container.addEventListener('touchmove', (e) => {
          if (!isScrolling) return;
          e.preventDefault();
          const x = e.touches[0].pageX - this.container.offsetLeft;
          const walk = (x - startX) * 1.5;
          this.container.scrollLeft = scrollLeft - walk;
        });

        this.container.addEventListener('touchend', () => {
          isScrolling = false;
        });
      }
    }

    customElements.define('product-collection-grid-{{ ai_gen_id }}', ProductCollectionGrid{{ ai_gen_id }});
  })();
</script>

