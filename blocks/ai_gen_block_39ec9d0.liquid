{% doc %}
  @prompt
    Create a benefits section with a light green background featuring a main heading "6 Core Benefits for Long-Term Health" and descriptive text, followed by 6 benefit items. Each benefit should have a green bullet point, a bold title, and descriptive text underneath. The benefits are: Energy & Allergies (increases energy while relieving allergies), Digestion & Gut balance (probiotics support), Skin & Coat (shinier coat & less itching), Hip & Joint (reduced inflammation), Immunity (better gut health for stronger immune function), and Heart Health (CoQ10 cardiovascular support). Use clean typography with good spacing between items and a modern, health-focused design suitable for pet products., Good start, please add an image block above the '6 Core...' heading, with a border radius to make it look like a circular. 
    
    Also create a span for the '6 Core Benefits' text and highlight the background of just those words with this color: #D7FAD2FF.
    
    For the list of benefits, please put a green dot with this color in front of each benefit: #7BBC72FF.
    
    Also make the background-color of the whole section white instead of the current green.
    
    For mobile the 1-column design is good, for desktop please use two columns, with on the left only the big image block, and on the right the list of benefits., Please left-align the heading text as well as the heading description text.
    
    Also make the image bigger, fill it for 80% relative to the screen size of mobile, and 80% of the column on desktop.
    
    Please add green bullet points in front of every benefit title. Use this color for that: #7BBC72FF.
    
    Also give me the ability to gap between the benefit items (also below 16).

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .benefits-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .benefits-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .benefits-content-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .benefits-header-{{ ai_gen_id }} {
    text-align: left;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .benefits-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin-bottom: 16px;
  }

  .benefits-highlight-{{ ai_gen_id }} {
    background-color: #D7FAD2;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .benefits-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .benefits-image-container-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
    width: 80%;
    margin-left: auto;
    margin-right: auto;
  }

  .benefits-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    padding-bottom: 100%;
    position: relative;
    border-radius: 50%;
    overflow: hidden;
  }

  .benefits-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .benefits-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 50%;
  }

  .benefits-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .benefit-item-{{ ai_gen_id }} {
    display: flex;
    margin-bottom: {{ block.settings.item_spacing }}px;
  }

  .benefit-bullet-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    min-width: 16px;
    border-radius: 50%;
    background-color: #7BBC72;
    margin-right: 16px;
    margin-top: 6px;
  }

  .benefit-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .benefit-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.benefit_title_color }};
    margin-bottom: 8px;
  }

  .benefit-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  @media screen and (min-width: 750px) {
    .benefits-content-wrapper-{{ ai_gen_id }} {
      flex-direction: row;
      align-items: center;
      gap: 40px;
    }

    .benefits-image-container-{{ ai_gen_id }} {
      flex: 1;
      margin-bottom: 0;
      width: 80%;
    }

    .benefits-content-{{ ai_gen_id }} {
      flex: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .benefits-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .benefit-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.benefit_title_size | times: 0.9 }}px;
    }

    .benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="benefits-container-{{ ai_gen_id }}">
    <div class="benefits-content-wrapper-{{ ai_gen_id }}">
      <div class="benefits-image-container-{{ ai_gen_id }}">
        <div class="benefits-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img 
              src="{{ block.settings.main_image | image_url: width: 600 }}" 
              alt="{{ block.settings.main_image.alt | escape }}"
              class="benefits-image-{{ ai_gen_id }}"
              width="{{ block.settings.main_image.width }}"
              height="{{ block.settings.main_image.height }}"
              loading="lazy"
            >
          {% else %}
            <div class="benefits-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="benefits-content-{{ ai_gen_id }}">
        <div class="benefits-header-{{ ai_gen_id }}">
          <h2 class="benefits-title-{{ ai_gen_id }}">
            <span class="benefits-highlight-{{ ai_gen_id }}">6 Core Benefits</span> for Long-Term Health
          </h2>
          <div class="benefits-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        </div>

        <div class="benefits-grid-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% assign title_key = 'benefit_' | append: i | append: '_title' %}
            {% assign text_key = 'benefit_' | append: i | append: '_text' %}
            
            {% if block.settings[title_key] != blank %}
              <div class="benefit-item-{{ ai_gen_id }}">
                <div class="benefit-bullet-{{ ai_gen_id }}"></div>
                <div class="benefit-content-{{ ai_gen_id }}">
                  <h3 class="benefit-title-{{ ai_gen_id }}">{{ block.settings[title_key] }}</h3>
                  <div class="benefit-text-{{ ai_gen_id }}">{{ block.settings[text_key] }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

