      "default": "*for all dog weights and breeds"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 10,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Subtext size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Right content"
    },
    {
      "type": "text",
      "id": "amount_text",
