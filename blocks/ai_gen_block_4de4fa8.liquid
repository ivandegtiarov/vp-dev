{% doc %}
  @prompt
    Create an informational banner block with a light gray background and rounded corners. On the left side, display an image of a chew/supplement (with image upload option). In the center, show a bold heading "Dosage per dog:" with italic subtext "*for all dog weights and breeds" below it. On the right side, display "1 jar / month" in italic and "2 chews daily" below it. Make it responsive for mobile and desktop, with proper spacing and alignment. All text should be editable through block settings, and include an image upload option for the product icon., it should be in the row direction, with the image on the left , the two lines: 'dosage + for all dog weights...' text next to it (left-aligned), followed by the third column which is the remaining 2 lines (right-aligned)., good, but switch the '2 chews daily' to the top, and the 1 jar / month to the bottom. create a little bit of margin around the snippet itself too.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dosage-banner-wrapper-{{ ai_gen_id }} {
    margin: {{ block.settings.margin_vertical }}px {{ block.settings.margin_horizontal }}px;
  }

  .ai-dosage-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
  }

  .ai-dosage-banner__image-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
  }

  .ai-dosage-banner__image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-dosage-banner__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-dosage-banner__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-dosage-banner__center-{{ ai_gen_id }} {
    flex-grow: 1;
    text-align: left;
  }

  .ai-dosage-banner__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
    line-height: 1.2;
  }

  .ai-dosage-banner__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    font-style: italic;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-dosage-banner__right-{{ ai_gen_id }} {
    flex-shrink: 0;
    text-align: right;
  }

  .ai-dosage-banner__amount-{{ ai_gen_id }} {
    font-size: {{ block.settings.amount_size }}px;
    font-weight: 600;
    color: {{ block.settings.amount_color }};
    margin: 0 0 4px 0;
    line-height: 1.2;
  }

  .ai-dosage-banner__frequency-{{ ai_gen_id }} {
    font-size: {{ block.settings.frequency_size }}px;
    font-style: italic;
    color: {{ block.settings.frequency_color }};
    margin: 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-dosage-banner-wrapper-{{ ai_gen_id }} {
      margin: {{ block.settings.margin_vertical | times: 0.7 }}px {{ block.settings.margin_horizontal | times: 0.7 }}px;
    }

    .ai-dosage-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
      gap: 12px;
    }

    .ai-dosage-banner__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.7 }}px;
      height: {{ block.settings.image_size | times: 0.7 }}px;
    }

    .ai-dosage-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-dosage-banner__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.85 }}px;
    }

    .ai-dosage-banner__frequency-{{ ai_gen_id }} {
      font-size: {{ block.settings.frequency_size | times: 0.85 }}px;
    }

    .ai-dosage-banner__amount-{{ ai_gen_id }} {
      font-size: {{ block.settings.amount_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-dosage-banner-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dosage-banner-{{ ai_gen_id }}">
    <div class="ai-dosage-banner__image-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 200 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          loading="lazy"
          width="200"
          height="200"
        >
      {% else %}
        <div class="ai-dosage-banner__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-dosage-banner__center-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <div class="ai-dosage-banner__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </div>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <div class="ai-dosage-banner__subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext }}
        </div>
      {% endif %}
    </div>

    <div class="ai-dosage-banner__right-{{ ai_gen_id }}">
      {% if block.settings.amount_text != blank %}
        <div class="ai-dosage-banner__amount-{{ ai_gen_id }}">
          {{ block.settings.amount_text }}
        </div>
      {% endif %}
      {% if block.settings.frequency_text != blank %}
        <div class="ai-dosage-banner__frequency-{{ ai_gen_id }}">
          {{ block.settings.frequency_text }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

