      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Image size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Center content"
    },
    {
      "type": "text",
