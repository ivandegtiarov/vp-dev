{% doc %}
  @prompt
    Create a frequently asked questions (FAQ) section with a centered heading "Frequently Asked Questions" and 8 collapsible question items. Each question should be clickable to expand and show the answer. The questions are: "What if my dog doesn't like the chews?", "At what age can my pup start using these?", "What does 100% Human-Grade mean?", "How long until I start seeing the benefits?", "How many chews come in a jar?", "What flavour is the Multivitamin?", "What happens if I accidentally give my dog too many chews?", and "Can I take this dog multivitamin with other supplements?". Use clean typography with proper spacing, collapsible functionality with smooth animations, and a modern design suitable for a pet health product website.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .faq-heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
  }

  .faq-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .faq-item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.item_background }};
    transition: box-shadow 0.3s ease;
  }

  .faq-item-{{ ai_gen_id }}:hover {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
  }

  .faq-question-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 20px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: {{ block.settings.question_size }}px;
    font-weight: {{ block.settings.question_weight }};
    color: {{ block.settings.question_color }};
  }

  .faq-question-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.question_color }};
    outline-offset: -2px;
  }

  .faq-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    position: relative;
    flex-shrink: 0;
    margin-left: 10px;
  }

  .faq-icon-{{ ai_gen_id }}::before,
  .faq-icon-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    background-color: {{ block.settings.icon_color }};
    transition: transform 0.3s ease;
  }

  .faq-icon-{{ ai_gen_id }}::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }

  .faq-icon-{{ ai_gen_id }}::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }

  .faq-item-{{ ai_gen_id }}.active .faq-icon-{{ ai_gen_id }}::after {
    transform: translateX(-50%) rotate(90deg);
  }

  .faq-answer-{{ ai_gen_id }} {
    padding: 0 20px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
  }

  .faq-item-{{ ai_gen_id }}.active .faq-answer-{{ ai_gen_id }} {
    padding: 0 20px 20px;
    max-height: 1000px;
  }

  @media screen and (max-width: 749px) {
    .faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }
    
    .faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size | times: 0.9 }}px;
      padding: 15px;
    }
    
    .faq-item-{{ ai_gen_id }}.active .faq-answer-{{ ai_gen_id }} {
      padding: 0 15px 15px;
    }
  }
{% endstyle %}

<div class="faq-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="faq-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  
  <div class="faq-list-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% assign question_key = 'question_' | append: i %}
      {% assign answer_key = 'answer_' | append: i %}
      
      {% if block.settings[question_key] != blank and block.settings[answer_key] != blank %}
        <div class="faq-item-{{ ai_gen_id }}">
          <button 
            class="faq-question-{{ ai_gen_id }}" 
            aria-expanded="false"
            aria-controls="faq-answer-{{ ai_gen_id }}-{{ i }}"
          >
            {{ block.settings[question_key] }}
            <span class="faq-icon-{{ ai_gen_id }}"></span>
          </button>
          <div 
            id="faq-answer-{{ ai_gen_id }}-{{ i }}"
            class="faq-answer-{{ ai_gen_id }}"
          >
            {{ block.settings[answer_key] }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  (function() {
    class FaqAccordion extends HTMLElement {
      constructor() {
        super();
        this.faqItems = this.querySelectorAll('.faq-item-{{ ai_gen_id }}');
        this.init();
      }
      
      init() {
        this.faqItems.forEach(item => {
          const question = item.querySelector('.faq-question-{{ ai_gen_id }}');
          const answer = item.querySelector('.faq-answer-{{ ai_gen_id }}');
          
          question.addEventListener('click', () => {
            const isExpanded = question.getAttribute('aria-expanded') === 'true';
            
            // Close all other items
            if (!isExpanded && {{ block.settings.close_others }}) {
              this.faqItems.forEach(otherItem => {
                if (otherItem !== item) {
                  otherItem.classList.remove('active');
                  const otherQuestion = otherItem.querySelector('.faq-question-{{ ai_gen_id }}');
                  otherQuestion.setAttribute('aria-expanded', 'false');
                }
              });
            }
            
            // Toggle current item
            item.classList.toggle('active');
            question.setAttribute('aria-expanded', !isExpanded);
          });
        });
      }
    }
    
    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion);
    
    // Initialize the component
    const faqContainer = document.querySelector('.faq-container-{{ ai_gen_id }}');
    if (faqContainer) {
      new FaqAccordion();
    }
  })();
</script>

