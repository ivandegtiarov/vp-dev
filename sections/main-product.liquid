<script>
  document.addEventListener('DOMContentLoaded', function() {
      const initLoopSync = () => {
          const autoRefill = document.querySelector('input#auto_refill');
          const onetimeOption = document.querySelector('.loop-widget-purchase-option-onetime');
          // The subscription option usually has this specific data attribute
          const subOption = document.querySelector('[data-loop-widget-selling-plan-group]');
          const mainProductWrapper = document.querySelector('.product__info-wrapper');

          if (autoRefill && onetimeOption && subOption) {
              autoRefill.addEventListener('change', function() {
                  if (this.checked) {
                      document.querySelector('[data-loop-widget-selling-plan-group]').click(); // Triggers Loop's internal logic
                      console.log('subOption clicked');
                      mainProductWrapper.classList.remove('single_purchase_option');
                  } else {
                      document.querySelector('.loop-widget-purchase-option-onetime').click(); // Reverts to one-time
                      console.log('onetimeOption clicked');
                      mainProductWrapper.classList.add('single_purchase_option');
                  }
              });

              // Initial sync based on checkbox state
              if (autoRefill.checked) {
                  subOption.click();
              } else {
                  onetimeOption.click();
              }
          }
      };

      // Initialize logic
      initLoopSync();

      // Loop widget often loads dynamically, so we watch for its appearance
      const observer = new MutationObserver((mutations) => {
          if (document.querySelector('.loop-widget-purchase-option-onetime')) {
              initLoopSync();
              observer.disconnect();
          }
      });

      observer.observe(document.body, { childList: true, subtree: true });
  });
</script>