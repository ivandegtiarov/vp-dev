<style>
  .icon-w-text-wrapper {
    display: flex;
    position: relative;
    flex-grow: 1;
    max-width: 100%;
    min-width: auto;
    align-self: stretch;
    flex-basis: auto;
    min-height: 1px;
    align-items: center;
    flex-shrink: 1;
    padding-top: 60px;
    padding-left: 40px;
    padding-right: 40px;
    flex-direction: column;
    padding-bottom: 60px;
    justify-content: center;
    background-color: #7bbc7214;
    background-image: none;
  }

  .icon-w-text-wrapper-container {
    width: 100%;
    display: flex;
    row-gap: 30px;
    position: relative;
    flex-grow: 1;
    max-width: 1015px;
    min-width: auto;
    column-gap: 30px;
    flex-basis: auto;
    min-height: 1px;
    align-items: flex-start;
    flex-shrink: 1;
    justify-content: center;
  }

  .icon-w-text-wrapper-icon-image {
    display: flex;
    min-width: 0;
    flex-basis: auto;
    max-height: 70px;
    min-height: 0;
    object-fit: cover;
    overflow-x: auto;
    overflow-y: hidden;
    align-items: center;
    flex-shrink: 0;
    max-width: 70px;
  }

  .icon-w-text-wrapper-icon img {
    height: 100%;
    margin: 0;
    display: block;
    padding: 0;
    max-width: 100%;
    min-width: 100%;
    max-height: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .icon-w-text-wrapper-icon-title {
    font-size: 16px;
    align-self: stretch;
    flex-basis: auto;
    text-align: center;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 20px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    text-align-last: center;
    color: #000000;
    margin: 0;
    width: 100%;
  }

  .icon-w-text-wrapper-icon {
    display: flex;
    row-gap: 6px;
    position: relative;
    flex-grow: 1;
    max-width: 100%;
    align-self: stretch;
    column-gap: 6px;
    flex-basis: 0;
    min-height: 1px;
    align-items: center;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: flex-start;
  }

  @media (max-width: 640px) {
    .icon-w-text-wrapper {
      align-self: stretch;
      flex-basis: auto;
      min-height: 1px;
      align-items: center;
      flex-shrink: 1;
      padding-top: 40px;
      padding-left: 16px;
      padding-right: 16px;
      flex-direction: column;
      padding-bottom: 40px;
      justify-content: center;
      background-color: #7bbc7214;
      background-image: none;
    }

    .icon-w-text-wrapper-container {
      width: 100%;
      display: flex;
      row-gap: 24px;
      overflow: visible;
      position: relative;
      flex-grow: 1;
      flex-wrap: wrap;
      max-width: 635px;
      min-width: auto;
      column-gap: 24px;
      flex-basis: auto;
      min-height: 1px;
      align-items: flex-start;
      flex-shrink: 1;
      justify-content: center;
    }

    .icon-w-text-wrapper-icon-image {
      display: flex;
      max-width: 36px;
      min-width: 0;
      flex-basis: auto;
      max-height: 70px;
      min-height: 0;
      object-fit: cover;
      overflow-x: auto;
      overflow-y: hidden;
      align-items: center;
      flex-shrink: 0;
    }

    .icon-w-text-wrapper-icon-title {
      font-size: 14px;
      align-self: stretch;
      flex-basis: auto;
      text-align: center;
      flex-shrink: 0;
      font-weight: 600;
      line-height: 18px;
      letter-spacing: 0px;
      text-align-last: center;
      margin: 0;
    }

    .icon-w-text-wrapper-icon {
      width: auto;
      display: flex;
      row-gap: 6px;
      position: relative;
      flex-grow: unset;
      max-width: 105px;
      align-self: stretch;
      column-gap: 6px;
      flex-basis: auto;
      min-height: 1px;
      align-items: center;
      flex-shrink: 0;
      flex-direction: column;
      justify-content: flex-start;
    }
  }
</style>

<div class="icon-w-text-wrapper">
  <div class="icon-w-text-wrapper-container">
    {% for block in section.blocks %}
      <div class="icon-w-text-wrapper-icon">
        <div class="icon-w-text-wrapper-icon-image">
          <img
            src="{{ block.settings.icon | image_url: width: 140 }}"
            alt="{{ block.settings.title }}"
            width="70"
            height="70"
          >
        </div>
        <h2 class="icon-w-text-wrapper-icon-title">{{ block.settings.title }}</h2>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Icon with text - Product",
  "settings": [],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon with text - Product"
    }
  ]
}
{% endschema %}
