<style>
  .reviews-section {
    max-width: 1158px;
    display: flex;
    position: relative;
    max-width: 1158px;
    min-width: auto;
    align-self: auto;
    flex-basis: auto;
    min-height: 1px;
    align-items: flex-start;
    flex-shrink: 0;
    padding-top: 30px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
  }

  .reviews-section__wrapper {
    padding-bottom: 0 !important;
    padding-top: 0 !important;
  }

  .reviews-section__stars {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .reviews-section__stars svg {
    width: 16px;
    height: 16px;
    fill: #7bbc72;
  }

  .reviews-section__title {
    font-size: 35px;
    font-weight: bold;
    margin: 5px 0;
    color: #000000;
  }

  .reviews-section__rating {
    display: flex;
    gap: 5px;
    margin: 0;
  }

  .reviews-section__score {
    font-weight: bold;
    padding: 5px 0;
    color: #000000;
    margin: 0;
  }

  .reviews-section__count {
    margin: 0;
  }

  .reviews-section__images-grid {
    gap: 15px;
    display: grid;
    position: relative;
    flex-grow: 1;
    min-width: auto;
    align-self: stretch;
    flex-basis: auto;
    min-height: 1px;
    align-items: center;
    flex-shrink: 1;
    justify-content: space-between;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .reviews-section__image-item {
    display: flex;
    overflow: hidden;
    flex-grow: 1;
    max-width: 120px;
    min-width: 0;
    flex-basis: auto;
    min-height: 0;
    object-fit: cover;
    align-items: center;
    flex-shrink: 1;
    border-radius: 10px;
  }

  .reviews-section__image-item img {
    height: 100%;
    margin: 0;
    display: block;
    padding: 0;
    max-width: 100%;
    min-width: 100%;
    max-height: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .reviews-section__images-grid-wrapper {
    margin-top: 15px;
  }

  .reviews-section-reviews-grid-wrapper {
    width: 100%;
    display: flex;
    row-gap: 16px;
    position: relative;
    align-self: center;
    column-gap: 16px;
    align-items: flex-start;
    padding-top: 30px;
    flex-direction: column;
    padding-bottom: 112px;
    justify-content: center;
  }

  .reviews-section-reviews-grid-wrapper__title {
    font-size: 20px;
    flex-basis: auto;
    flex-shrink: 0;
    line-height: 24px;
    overflow-wrap: break-word;
    color: #000000;
    font-weight: 400;
    margin: 0;
  }

  .reviews-section-reviews-grid-wrapper__reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .reviews-section-reviews-grid-wrapper__review-item {
    display: flex;
    row-gap: 16px;
    position: relative;
    max-width: 100%;
    min-width: auto;
    align-self: stretch;
    column-gap: 16px;
    flex-basis: auto;
    min-height: 1px;
    align-items: flex-start;
    flex-shrink: 0;
    padding-top: 32px;
    padding-left: 32px;
    padding-right: 32px;
    flex-direction: column;
    padding-bottom: 32px;
    justify-content: center;
    border-top-color: #8b8b8bff;
    border-top-style: solid;
    border-top-width: 1px;
  }

  .grid-wrapper__review-item-stars {
    display: flex;
    row-gap: 4px;
    column-gap: 4px;
  }

  .grid-wrapper__review-item-stars svg {
    width: 16px;
    height: 16px;
    fill: #7bbc72;
  }

  .grid-wrapper__review-item-name-wrapper {
    display: flex;
    row-gap: 16px;
    position: relative;
    max-width: 100%;
    min-width: auto;
    align-self: stretch;
    column-gap: 16px;
    flex-basis: auto;
    min-height: 1px;
    align-items: center;
    flex-shrink: 0;
    justify-content: flex-start;
  }

  .grid-wrapper__review-item-name {
    margin: 0;
    flex-grow: 1;
    font-size: 16px;
    flex-shrink: 1;
    font-weight: 600;
    line-height: 24px;
    overflow-wrap: break-word;
    color: #000000;
  }

  .grid-wrapper__review-item-name-wrapper a {
    text-decoration: none;
    color: #000000;
  }

  .grid-wrapper__review-item-verified {
    flex-basis: auto;
    font-style: italic;
    flex-shrink: 0;
    line-height: 24px;
    overflow-wrap: break-word;
    color: #000000;
    margin: 0;
  }

  .grid-wrapper__review-item-text {
    font-size: 18px;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 0;
    font-weight: 400;
    line-height: 27px;
    overflow-wrap: break-word;
    color: #000000;
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    .reviews-section-reviews-grid-wrapper__reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .reviews-section {
      padding: 30px 15px;
    }

    .reviews-section-reviews-grid-wrapper__reviews-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 20px;
    }

    .reviews-section-reviews-grid-wrapper__title {
      font-size: 16px;
    }

    .reviews-section-reviews-grid-wrapper {
      gap: 30px;
    }

    .reviews-section-reviews-grid-wrapper {
      padding-block: 30px 0;
    }

    .reviews-section-reviews-grid-wrapper__review-item {
      height: auto;
      display: flex;
      row-gap: 16px;
      position: relative;
      flex-grow: unset;
      max-width: 100%;
      min-width: auto;
      align-self: stretch;
      column-gap: 16px;
      flex-basis: auto;
      min-height: 1px;
      align-items: flex-start;
      flex-shrink: 0;
      padding-top: 16px;
      padding-left: 16px;
      padding-right: 16px;
      flex-direction: column;
      padding-bottom: 16px;
      justify-content: center;
      border-top-color: #8b8b8bff;
      border-top-style: solid;
      border-top-width: 1px;
    }

    .grid-wrapper__review-item-text {
      font-size: 16px;
    }

    .grid-wrapper__review-item-name-wrapper {
      display: flex;
      row-gap: 8px;
      position: relative;
      max-width: 100%;
      min-width: auto;
      align-self: stretch;
      column-gap: 8px;
      flex-basis: auto;
      min-height: 1px;
      align-items: center;
      flex-shrink: 0;
      justify-content: space-between;
    }
  }
</style>

<div class="reviews-section">
  <div class="reviews-section__wrapper">
    <div class="section">
      <div class="reviews-section__content">
        <h2 class="reviews-section__title h2">{{ section.settings.title | escape }}</h2>
        <div class="reviews-section__rating">
          <span class="reviews-section__stars">
            {% for i in (1..5) %}
              {% render 'icon-star' %}
            {% endfor %}
          </span>
          <span class="reviews-section__score"> - {{ section.settings.rating_text | escape }}</span>
        </div>
        <i>
          <p class="reviews-section__count">{{ section.settings.review_count_text | escape }}</p>
        </i>
      </div>
    </div>
  </div>
  <div class="judgeme-integrations-wrapper">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
  <div class="reviews-section__images-grid-wrapper">
    <div class="reviews-section__images-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review_image' %}
          <div class="reviews-section__image-item">
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              alt="{{ block.settings.image.alt }}"
              width="100%"
              height="100%"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="reviews-section-reviews-grid-wrapper">
    <h2 class="reviews-section-reviews-grid-wrapper__title">Recent reviews:</h2>
    <div class="reviews-section-reviews-grid-wrapper__reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review_item' %}
          <div class="reviews-section-reviews-grid-wrapper__review-item">
            <div class="grid-wrapper__review-item-stars">
              {% for i in (1..5) %}
                {% render 'icon-star' %}
              {% endfor %}
            </div>
            <div class="grid-wrapper__review-item-name-wrapper">
              <a href="{{ block.settings.review_url | escape }}">
                <p class="grid-wrapper__review-item-name">{{ block.settings.review_name | escape }}</p>
              </a>
              <p class="grid-wrapper__review-item-verified">{{ block.settings.review_verified | escape }}</p>
            </div>
            <div class="grid-wrapper__review-item-text">
              {{ block.settings.review_text | escape }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "Rated 4.8/5"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review Count Text",
      "default": "Based on 486+ verified reviews"
    },
    {
      "type": "richtext",
      "id": "judgeme_integrations",
      "label": "Judgeme App Integrations"
    }
  ],
  "blocks": [
    {
      "type": "review_image",
      "name": "Review Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "review_item",
      "name": "Review Item",
      "settings": [
        {
          "type": "text",
          "id": "review_name",
          "label": "Review Name"
        },
        {
          "type": "text",
          "id": "review_verified",
          "label": "Review Verified"
        },
        {
          "type": "url",
          "id": "review_url",
          "label": "Review URL"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Text"
        }
      ]
    },
    {
      "type": "@app",
    }
  ],
  "presets": [
    {
      "name": "Custom Reviews",
      "settings": {
        "title": "Customer Reviews",
        "rating_text": "Rated 4.8/5",
        "review_count_text": "Based on 486+ verified reviews"
      }
    }
  ]
}
{% endschema %}
