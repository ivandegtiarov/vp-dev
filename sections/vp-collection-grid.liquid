<style>
  .vp-cg-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .vp-cg-inner {
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Layout: cards left, title right ── */
  .vp-cg-layout {
    display: grid;
    grid-template-columns: 690px 1fr;
    gap: 64px;
    align-items: center;
  }

  /* desktop: smaller cards */
  @media (min-width: 901px) {
    .vp-cg-card-media {
      aspect-ratio: 3 / 2;
    }

    .vp-cg-card-body {
      padding: 10px 14px 12px;
      gap: 5px;
    }

    .vp-cg-category {
      font-size: 9px;
      letter-spacing: 0.08em;
    }

    .vp-cg-card-title {
      font-size: 14px;
      line-height: 1.2;
    }

    .vp-cg-stars {
      gap: 2px;
    }

    .vp-cg-stars svg {
      width: 12px;
      height: 12px;
    }

    .vp-cg-description {
      font-size: 11px;
      line-height: 1.4;
      -webkit-line-clamp: 1;
    }

    .vp-cg-free-gift {
      font-size: 11px;
    }

    .vp-cg-price-row {
      padding-top: 0;
      gap: 6px;
    }

    .vp-cg-price-label {
      font-size: 10px;
    }

    .vp-cg-price-compare {
      font-size: 12px;
    }

    .vp-cg-price-sale {
      font-size: 14px;
    }

    .vp-cg-btn {
      font-size: 12px;
      padding: 9px 12px;
      margin-top: 6px;
      border-radius: 6px;
    }
  }

  /* ── Layout: title above, cards centered ── */
  .vp-cg-layout--above {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .vp-cg-layout--above .vp-cg-sidebar {
    text-align: center;
    align-items: center;
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
    order: -1;
  }

  .vp-cg-layout--above .vp-cg-heading {
    font-size: 38px;
  }

  .vp-cg-layout--above .vp-cg-subheading {
    font-size: 16px;
  }

  .vp-cg-layout--above .vp-cg-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    max-width: 870px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Right/default: heading block ── */
  .vp-cg-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .vp-cg-eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7bbc72;
  }

  .vp-cg-heading {
    font-family: 'Inter', sans-serif;
    font-size: 54px;
    font-weight: 700;
    line-height: 1.1;
    color: #121212;
    margin: 0;
  }

  .vp-cg-heading em {
    font-style: italic;
    color: #7bbc72;
  }

  /* heading fade-in */
  .vp-cg-heading {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .vp-cg-heading.vp-animated {
    opacity: 1;
    transform: translateY(0);
  }

  .vp-cg-subheading {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #535353;
    line-height: 1.6;
    margin: 0;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease 0.6s, transform 0.5s ease 0.6s;
  }

  .vp-cg-sidebar.vp-animated .vp-cg-subheading {
    opacity: 1;
    transform: translateY(0);
  }

  .vp-cg-sidebar-cta {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease 0.75s, transform 0.5s ease 0.75s;
  }

  .vp-cg-sidebar.vp-animated .vp-cg-sidebar-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .vp-cg-view-all {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #121212;
    border: 2px solid #121212;
    padding: 14px 40px;
    border-radius: 60px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .vp-cg-view-all:hover {
    background: #121212;
    color: #fff;
  }

  /* ── Left: card grid ── */
  .vp-cg-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    align-items: stretch;
  }

  .vp-cg-card {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid #ebebeb;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    opacity: 0;
    transform: translateY(24px);
    height: 100%;
  }

  .vp-cg-card.vp-card-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.25s ease;
  }

  .vp-cg-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10);
  }

  .vp-cg-card-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    flex-shrink: 0;
  }

  .vp-cg-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .vp-cg-card:hover .vp-cg-card-media img {
    transform: scale(1.04);
  }

  .vp-cg-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #7bbc72;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 4px;
    z-index: 2;
    white-space: nowrap;
  }

  .vp-cg-card-body {
    padding: 20px 20px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 5px;
  }

  .vp-cg-category {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #535353;
    margin: 0;
  }

  .vp-cg-card-title {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    color: #121212;
    margin: 0;
  }

  .vp-cg-stars {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .vp-cg-stars svg {
    width: 16px;
    height: 16px;
  }

  .vp-cg-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #666;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .vp-cg-free-gift {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #7bbc72;
    margin: 0;
  }

  .vp-cg-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
  }

  .vp-cg-price-label {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #888;
  }

  .vp-cg-price-compare {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #aaa;
    text-decoration: line-through;
  }

  .vp-cg-price-sale {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #7bbc72;
  }

  .vp-cg-btn {
    display: block;
    width: 100%;
    background: #7bbc72;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
    padding: 13px 20px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    margin-top: 16px;
    transition: background 0.2s ease;
  }

  .vp-cg-btn:hover {
    background: #62915c;
    color: #fff;
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .vp-cg-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    /* sidebar moves to top on mobile */
    .vp-cg-sidebar {
      order: -1;
      text-align: center;
      align-items: center;
    }

    .vp-cg-heading {
      font-size: 36px;
    }
  }

  @media (max-width: 640px) {
    .vp-cg-inner {
      padding: 0 0 0 16px;
    }

    .vp-cg-heading {
      font-size: 32px;
    }

    .vp-cg-subheading {
      font-size: 16px;
    }

    /* horizontal scroll on mobile */
    .vp-cg-grid {
      grid-template-columns: unset;
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      padding-bottom: 16px;
      padding-right: 16px;
      /* hide scrollbar */
      scrollbar-width: none;
    }

    .vp-cg-grid::-webkit-scrollbar {
      display: none;
    }

    .vp-cg-card {
      flex: 0 0 78vw;
      max-width: 300px;
      scroll-snap-align: start;
      height: auto;
    }

    .vp-cg-card-title {
      font-size: 17px;
    }

    .vp-cg-price-sale {
      font-size: 17px;
    }

    .vp-cg-btn {
      font-size: 14px;
      padding: 12px 14px;
    }

    .vp-cg-sidebar {
      padding: 0 16px;
    }
  }
</style>

<section id="vp-cg-section" class="vp-cg-section">
  <div class="vp-cg-inner">
    {%- if section.settings.header_position == 'above' -%}
      {%- assign layout_class = 'vp-cg-layout vp-cg-layout--above' -%}
    {%- else -%}
      {%- assign layout_class = 'vp-cg-layout' -%}
    {%- endif -%}
    <div class="{{ layout_class }}">

      <!-- LEFT: cards -->
      <div class="vp-cg-grid">
        {%- for block in section.blocks -%}
          {%- assign prod = block.settings.product -%}
          <div class="vp-cg-card" data-card-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>

            {%- assign card_url = prod.url | default: '#' -%}
            <a href="{{ card_url }}" class="vp-cg-card-media" aria-label="{{ prod.title }}">
              {%- if block.settings.custom_image != blank -%}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 600 }}"
                  alt="{{ block.settings.custom_image.alt | default: prod.title }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {%- elsif prod and prod.featured_image != blank -%}
                <img
                  src="{{ prod.featured_image | image_url: width: 600 }}"
                  alt="{{ prod.featured_image.alt | default: prod.title }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- unless block.settings.badge == blank -%}
                <span class="vp-cg-badge">{{ block.settings.badge }}</span>
              {%- endunless -%}
            </a>

            <div class="vp-cg-card-body">
              {%- unless block.settings.category_label == blank -%}
                <p class="vp-cg-category">{{ block.settings.category_label }}</p>
              {%- endunless -%}

              <h3 class="vp-cg-card-title">
                <a href="{{ card_url }}" style="text-decoration:none;color:inherit;">
                  {%- if block.settings.custom_title != blank -%}
                    {{ block.settings.custom_title }}
                  {%- else -%}
                    {{ prod.title }}
                  {%- endif -%}
                </a>
              </h3>

              {%- if block.settings.show_stars -%}
                <div class="vp-cg-stars" aria-label="{{ block.settings.star_count }} out of 5 stars">
                  {%- assign full_stars = block.settings.star_count | floor -%}
                  {%- assign half_star_index = full_stars | plus: 1 -%}
                  {%- assign has_half = false -%}
                  {%- if block.settings.star_count != full_stars -%}
                    {%- assign has_half = true -%}
                  {%- endif -%}
                  {%- for i in (1..5) -%}
                    {%- if i <= full_stars -%}
                      <svg viewBox="0 0 16 16" fill="#ffc107" xmlns="http://www.w3.org/2000/svg"><path d="M8 12.173l-4.944 2.6 .944-5.503L.001 5.627l5.528-.803L8 0l2.471 4.824L16 5.627l-3.999 3.643.944 5.503z"/></svg>
                    {%- elsif has_half and i == half_star_index -%}
                      <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="half-{{ block.id }}"><stop offset="50%" stop-color="#ffc107"/><stop offset="50%" stop-color="#e0e0e0"/></linearGradient></defs><path fill="url(#half-{{ block.id }})" d="M8 12.173l-4.944 2.6 .944-5.503L.001 5.627l5.528-.803L8 0l2.471 4.824L16 5.627l-3.999 3.643.944 5.503z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 16 16" fill="#e0e0e0" xmlns="http://www.w3.org/2000/svg"><path d="M8 12.173l-4.944 2.6 .944-5.503L.001 5.627l5.528-.803L8 0l2.471 4.824L16 5.627l-3.999 3.643.944 5.503z"/></svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- unless block.settings.description == blank -%}
                <p class="vp-cg-description">{{ block.settings.description }}</p>
              {%- endunless -%}

              {%- unless block.settings.free_gift_text == blank -%}
                <p class="vp-cg-free-gift">{{ block.settings.free_gift_text }}</p>
              {%- endunless -%}

              {%- if prod != blank -%}
                {%- assign sub_allocation = prod.variants.first.selling_plan_allocations.first -%}
                <div class="vp-cg-price-row">
                  <span class="vp-cg-price-label">From</span>
                  {%- if sub_allocation != blank -%}
                    {%- if sub_allocation.compare_at_price > sub_allocation.price -%}
                      <span class="vp-cg-price-compare">{{ sub_allocation.compare_at_price | money }}</span>
                    {%- endif -%}
                    <span class="vp-cg-price-sale">{{ sub_allocation.price | money }}</span>
                  {%- else -%}
                    {%- if prod.compare_at_price > prod.price -%}
                      <span class="vp-cg-price-compare">{{ prod.compare_at_price | money }}</span>
                    {%- endif -%}
                    <span class="vp-cg-price-sale">{{ prod.price | money }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <a href="{{ card_url }}" class="vp-cg-btn">
                {%- if block.settings.btn_label != blank -%}
                  {{ block.settings.btn_label }}
                {%- else -%}
                  Shop Now &rarr;
                {%- endif -%}
              </a>
            </div>

          </div>
        {%- endfor -%}
      </div>

      <!-- RIGHT: sidebar -->
      <div class="vp-cg-sidebar">
        {%- unless section.settings.eyebrow == blank -%}
          <span class="vp-cg-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endunless -%}

        {%- unless section.settings.heading == blank -%}
          <h2 id="vp-cg-heading" class="vp-cg-heading" data-vp-heading>{{ section.settings.heading }}</h2>
        {%- endunless -%}

        {%- unless section.settings.subheading == blank -%}
          <p class="vp-cg-subheading">{{ section.settings.subheading }}</p>
        {%- endunless -%}

        {%- if section.settings.show_view_all and section.settings.view_all_url != blank -%}
          <div class="vp-cg-sidebar-cta">
            <a href="{{ section.settings.view_all_url }}" class="vp-cg-view-all">
              {{ section.settings.view_all_label | default: 'View All Products' }}
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function applyBreakTags(el) {
      var isDesktop = window.innerWidth > 900;
      /* match both raw || and HTML-encoded &#124;&#124; that Shopify may output */
      el.innerHTML = el.innerHTML
        .replace(/(\|\||&#124;&#124;)/g, isDesktop ? '<br>' : '')
        .replace(/(\|m\||&#124;m&#124;)/g, isDesktop ? '' : '<br>');
    }

    function initSection(section) {
      var heading = section.querySelector('[data-vp-heading]');
      var sidebar = section.querySelector('.vp-cg-sidebar');
      var cards = section.querySelectorAll('.vp-cg-card');

      if (heading) {
        applyBreakTags(heading);
      }

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          if (heading) {
            heading.classList.add('vp-animated');
          }
          if (sidebar) {
            sidebar.classList.add('vp-animated');
          }

          cards.forEach(function (card, i) {
            setTimeout(function () {
              card.classList.add('vp-card-visible');
            }, i * 100);
          });
        });
      }, { threshold: 0.15 });

      observer.observe(section);
    }

    document.querySelectorAll('.vp-cg-section').forEach(initSection);
  })();
</script>

{% schema %}
{
  "name": "VP - Collection Grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "For Dogs"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use || for a desktop-only line break, |m| for a mobile-only line break",
      "default": "Everything your dog needs"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Vet-formulated supplements for every stage of your dog's life."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_position",
      "label": "Header position (desktop)",
      "options": [
        { "value": "right", "label": "Right of cards" },
        { "value": "above", "label": "Above cards (centered)" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Columns (desktop)"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "Card gap"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 8,
      "unit": "px",
      "label": "Card border radius"
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": false
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All Products"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#faf9f7"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        },
        {
          "type": "text",
          "id": "category_label",
          "label": "Category label",
          "default": "FOR DOGS"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "info": "e.g. 'BESTSELLER' — leave blank to hide"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show star rating",
          "default": true
        },
        {
          "type": "select",
          "id": "star_count",
          "label": "Star rating",
          "options": [
            { "value": "3", "label": "3 stars" },
            { "value": "3.5", "label": "3.5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "4.5", "label": "4.5 stars" },
            { "value": "5", "label": "5 stars" }
          ],
          "default": "5"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "text",
          "id": "free_gift_text",
          "label": "Free gift text",
          "info": "e.g. 'FREE gift over $50' — leave blank to hide"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button label",
          "default": "Shop Now →"
        }
      ]
    }
  ],
