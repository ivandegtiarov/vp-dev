        {
          "type": "ingredient",
          "settings": {
            "badge": "500M CFU",
            "title": "Probiotic Blend",
            "description": "Natural probiotics that restore gut balance & support immune health"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "badge": "200mg",
