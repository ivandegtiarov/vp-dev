<style>
  .image-w-text-wrapper {
    width: 100%;
    display: flex;
    row-gap: 60px;
    position: relative;
    max-width: 1158px;
    min-width: auto;
    column-gap: 60px;
    flex-basis: auto;
    min-height: 1px;
    align-items: stretch;
    flex-shrink: 0;
    padding-top: 80px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 80px;
    justify-content: space-between;
    margin-inline: auto;
  }

  .image-w-text-wrapper-container-image {
    display: flex;
    overflow: hidden;
    flex-grow: 1;
    max-width: 561px;
    object-fit: cover;
    overflow-x: auto;
    overflow-y: hidden;
    align-items: center;
    border-top-left-radius: 500px;
    border-top-right-radius: 500px;
    border-bottom-left-radius: 500px;
    border-bottom-right-radius: 500px;
  }

  .image-w-text-wrapper-container-image img {
    height: 100%;
    margin: 0;
    display: block;
    padding: 0;
    max-width: 100%;
    min-width: 100%;
    max-height: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .image-w-text-wrapper-container-text {
    display: flex;
    row-gap: 16px;
    position: relative;
    flex-grow: 1;
    max-width: 475px;
    column-gap: 16px;
    align-items: center;
    flex-direction: column;
    justify-content: flex-start;
  }

  .image-w-text-wrapper-title {
    font-size: 36px;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 43px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    margin: 0;
    width: 100%;
    color: #000000;
  }

  .image-w-text-wrapper-title span {
    background-color: #d7fad2ff;
    color: inherit;
  }

  .image-w-text-wrapper-subtitle {
    font-size: 16px;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 0;
    line-height: 20px;
    margin-block: 0 14px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    color: #000000;
    width: 100%;
  }

  .image-w-text-wrapper-benefits {
    display: flex;
    row-gap: 20px;
    position: relative;
    max-width: 100%;
    min-width: auto;
    align-self: stretch;
    column-gap: 20px;
    flex-basis: auto;
    min-height: 1px;
    align-items: center;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: flex-start;
  }

  .image-w-text-wrapper-benefit-content {
    display: flex;
    row-gap: 36px;
    position: relative;
    max-width: 100%;
    min-width: auto;
    align-self: stretch;
    column-gap: 36px;
    flex-basis: auto;
    min-height: 1px;
    align-items: flex-start;
    flex-shrink: 0;
    justify-content: flex-start;
  }

  .image-w-text-wrapper-benefit-dot {
    color: #ffffffff;
    width: 8px;
    height: 8px;
    display: flex !important;
    overflow: hidden;
    position: relative;
    min-width: auto;
    flex-basis: auto;
    margin-top: 8px;
    min-height: 1px;
    align-items: center;
    flex-shrink: 0;
    justify-content: center;
    background-color: #7bbc72ff;
    background-image: none;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
  }

  .image-w-text-wrapper-benefit-content-text {
    display: flex;
    row-gap: 6px;
    position: relative;
    flex-grow: 1;
    max-width: 100%;
    column-gap: 6px;
    flex-basis: 0;
    min-height: 1px;
    align-items: center;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
  }

  .image-w-text-wrapper-benefit-content-text h3 {
    font-size: 18px;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 26px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    color: #000000;
    margin: 0;
    width: 100%;
  }

  .image-w-text-wrapper-benefit-content-text p {
    font-size: 16px;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 0;
    font-weight: 400;
    line-height: 24px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    color: #000000;
    margin: 0;
    width: 100%;
  }

  @media screen and (max-width: 640px) {
    .image-w-text-wrapper {
      row-gap: 12px;
      position: relative;
      column-gap: 12px;
      flex-basis: auto;
      min-height: 1px;
      align-items: flex-start;
      flex-shrink: 0;
      padding-top: 0px;
      padding-left: 0px;
      padding-right: 0px;
      flex-direction: column-reverse;
      padding-bottom: 0px;
      justify-content: center;
      background-color: #ffffffff;
      background-image: none;
    }

    .image-w-text-wrapper-container-image img {
      width: 100%;
    }

    .image-w-text-wrapper-container-image {
      width: auto;
      height: auto;
      display: flex;
      overflow: hidden;
      flex-grow: 1;
      max-width: 561px;
      min-width: 0;
      align-self: stretch;
      flex-basis: auto;
      margin-top: 20px;
      min-height: 0;
      object-fit: cover;
      overflow-x: auto;
      overflow-y: hidden;
      align-items: center;
      flex-shrink: 1;
      margin-left: 20px;
      padding-top: 0px;
      margin-right: 20px;
      padding-left: 0px;
      padding-right: 0px;
      padding-bottom: 0px;
      border-top-left-radius: 400px;
      border-top-right-radius: 400px;
      border-bottom-left-radius: 400px;
      border-bottom-right-radius: 400px;
    }

    .image-w-text-wrapper-container-text {
      width: auto;
      height: auto;
      display: flex;
      row-gap: 16px;
      position: relative;
      flex-grow: 1;
      max-width: none;
      align-self: stretch;
      column-gap: 16px;
      flex-basis: auto;
      min-height: 1px;
      align-items: center;
      flex-shrink: 1;
      padding-top: 30px;
      margin-right: 0px;
      padding-left: 30px;
      padding-right: 30px;
      flex-direction: column;
      padding-bottom: 30px;
      justify-content: flex-start;
    }

    .image-w-text-wrapper-title {
       font-size: 24px;
        align-self: stretch;
        flex-basis: auto;
        margin-top: 0px;
        flex-shrink: 0;
        font-weight: 600;
        line-height: 32px;
        letter-spacing: 0px;
    }

    .image-w-text-wrapper-benefit-content-text p {
      font-size: 14px;
      line-height: 20px;
    }
  }
</style>

<div class="image-w-text-wrapper">
  <div class="image-w-text-wrapper-container-text">
    <h2 class="image-w-text-wrapper-title">
      <span>{{ section.settings.pre_title }}</span> {{ section.settings.title }}
    </h2>
    <p class="image-w-text-wrapper-subtitle">{{ section.settings.subtitle }}</p>
    <div class="image-w-text-wrapper-benefits">
      {% for block in section.blocks %}
        <div class="image-w-text-wrapper-benefit-content">
          <div class="image-w-text-wrapper-benefit-dot"></div>
          <div class="image-w-text-wrapper-benefit-content-text">
            <h3 class="image-w-text-wrapper-benefit-title">{{ block.settings.title }}</h3>
            <p class="image-w-text-wrapper-benefit-description">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="image-w-text-wrapper-container-image">
    <img
      src="{{ section.settings.image | image_url: width: 1400 }}"
      alt="{{ section.settings.image.alt }}"
      width="560"
      height="auto"
      loading="lazy"
    >
  </div>
</div>

{% schema %}
{
  "name": "Image with text - Product",
  "settings": [
    {
      "type": "text",
      "id": "pre_title",
      "label": "Pre Title",
      "default": "6 Core Benefits"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text - Product"
    }
  ]
}
{% endschema %}
