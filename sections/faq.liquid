<style>
  .accordion-faq-wrapper {
    width: 100%;
    display: flex;
    row-gap: 40px;
    position: relative;
    flex-grow: 1;
    max-width: 960px;
    min-width: auto;
    column-gap: 40px;
    flex-basis: auto;
    min-height: 1px;
    align-items: center;
    flex-shrink: 1;
    padding-top: 120px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: column;
    padding-bottom: 90px;
    justify-content: center;
    margin-inline: auto;
  }

  .accordion-faq-wrapper-title {
    font-size: 42px;
    font-weight: 700;
    align-self: stretch;
    flex-basis: auto;
    text-align: center;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 130%;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    text-align-last: center;
    width: 100%;
    margin: 0;
  }

  .accordion-faq-items-wrapper {
    display: flex;
    position: relative;
    flex-grow: 1;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 1;
    flex-direction: column;
  }

  .accordion-faq-item {
    display: flex;
    row-gap: 16px;
    position: relative;
    flex-grow: 1;
    align-self: stretch;
    column-gap: 16px;
    flex-basis: auto;
    flex-shrink: 1;
    padding-top: 15px;
    flex-direction: column;
    padding-bottom: 15px;
    border-bottom-color: #000000;
    border-bottom-style: solid;
    border-bottom-width: 0.5px;
  }

  .accordion-faq-item-title {
    cursor: pointer;
    display: flex;
    row-gap: 20px;
    position: relative;
    min-width: auto;
    align-self: stretch;
    column-gap: 20px;
    flex-basis: auto;
    min-height: 1px;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    align-items: center;
    flex-shrink: 0;
    justify-content: space-between;
  }

  .accordion-faq-item-title h3 {
    color: #03152aff;
    flex-grow: 1;
    font-size: 16px;
    transition: inherit;
    flex-shrink: 1;
    line-height: 24px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    font-weight: 600;
    margin: 0;
  }

  .accordion-faq-item-title svg {
    width: 24px;
    height: 24px;
    flex-basis: auto;
    transition: inherit;
    flex-shrink: 0;
  }

  .accordion-faq-item-content {
    color: #03152aff;
    font-size: 16px;
    align-self: stretch;
    flex-basis: auto;
    flex-shrink: 0;
    line-height: 24px;
    overflow-wrap: break-word;
    letter-spacing: 0px;
    background-color: rgb(241, 241, 241);
    padding: 1rem;
    border-radius: 10px;
  }

  .accordion-faq-item-content * {
    margin: 0;
  }

  .accordion-faq-item-content {
    display: none;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .accordion-faq-item.active .accordion-faq-item-content {
    display: block;
  }

  .icon-chevron {
    transition: transform 0.3s ease;
  }

  .icon-chevron.rotated {
    transform: rotate(180deg);
  }

  @media (max-width: 640px) {
    .accordion-faq-wrapper {
      background-color: #f9f9f9;
      width: 100%;
      display: flex;
      row-gap: 24px;
      position: relative;
      flex-grow: 1;
      max-width: none;
      min-width: auto;
      align-self: auto;
      column-gap: 24px;
      flex-basis: auto;
      min-height: 1px;
      align-items: center;
      flex-shrink: 1;
      padding-top: 40px;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      flex-direction: column;
      padding-bottom: 40px;
      justify-content: center;
    }

    .accordion-faq-wrapper-title {
      font-size: 28px;
      align-self: stretch;
      flex-basis: auto;
      text-align: center;
      flex-shrink: 0;
      font-weight: 700;
      line-height: 130%;
      letter-spacing: 0px;
      text-align-last: center;
    }

    .accordion-faq-item {
      display: flex;
      row-gap: 16px;
      position: relative;
      flex-grow: 1;
      align-self: stretch;
      column-gap: 16px;
      flex-basis: auto;
      flex-shrink: 1;
      padding-top: 15px;
      flex-direction: column;
      padding-bottom: 15px;
      border-bottom-color: #000000;
      border-bottom-style: solid;
      border-bottom-width: 0.5px;
    }

    .accordion-faq-item-title svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<div class="accordion-faq-wrapper">
  <h2 class="accordion-faq-wrapper-title">{{ section.settings.title }}</h2>
  <div class="accordion-faq-items-wrapper">
    {% for block in section.blocks %}
      <div class="accordion-faq-item">
        <div class="accordion-faq-item-title">
          <h3>{{ block.settings.title }}</h3>
          {% render 'icon-chevron' %}
        </div>
        <div class="accordion-faq-item-content">
          {{ block.settings.content }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const faqItems = document.querySelectorAll('.accordion-faq-item');

    faqItems.forEach((item, index) => {
      const content = item.querySelector('.accordion-faq-item-content');
      const chevron = item.querySelector('.icon-chevron');

      if (index === 0) {
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';
        chevron.classList.add('rotated');
      } else {
        content.style.maxHeight = null;
        chevron.classList.remove('rotated');
      }

      item.querySelector('.accordion-faq-item-title').addEventListener('click', () => {
        const isOpen = item.classList.contains('active');

        faqItems.forEach((otherItem) => {
          const otherContent = otherItem.querySelector('.accordion-faq-item-content');
          const otherChevron = otherItem.querySelector('.icon-chevron');

          otherItem.classList.remove('active');
          otherContent.style.maxHeight = null;
          otherChevron.classList.remove('rotated');
        });

        if (!isOpen) {
          item.classList.add('active');
          content.style.maxHeight = content.scrollHeight + 'px';
          chevron.classList.add('rotated');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Accordion - FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "What is the best way to feed my dog?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordion - FAQ"
    }
  ]
}
{% endschema %}
