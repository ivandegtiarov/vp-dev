<style>
  .journey-section {
    background: #faf9f7;
    padding: 20px 32px 60px;
    position: relative;
    overflow: hidden;
  }

  .journey-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
  }

  .journey-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 40px;
  }

  .journey-title {
    font-weight: 800;
    font-size: clamp(32px, 4.4vw, 52px);
    color: #1a1a1a;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .journey-title em {
    font-style: italic;
    font-weight: 700;
    color: #7bbc72;
  }

  .journey-subtitle {
    font-style: italic;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 18px);
    color: #2a2a2a;
    margin-top: 18px;
    line-height: 1.45;
  }

  /* ===== DESKTOP ===== */
  .journey-timeline-desktop {
    display: block;
    position: relative;
    padding-top: 8px;
  }

  .paw-trail-desktop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .paw-cluster {
    position: absolute;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .paw-cluster.d-1 { left: 17%; top: 16%; width: 19%; height: auto; }
  .paw-cluster.d-2 { left: 42%; top: 16%; width: 19%; height: auto; }
  .paw-cluster.d-3 { left: 67%; top: 16%; width: 19%; height: auto; }

  .journey-timeline-row {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: end;
  }

  .journey-step {
    text-align: center;
    position: relative;
    padding: 0 8px;
  }

  .journey-step:nth-child(1) { padding-bottom: 120px; }
  .journey-step:nth-child(2) { padding-bottom: 0; }
  .journey-step:nth-child(3) { padding-bottom: 120px; }
  .journey-step:nth-child(4) { padding-bottom: 0; }

  .journey-step-tile {
    width: 152px;
    height: 152px;
    margin: 0 auto 18px;
    background: #ffffff;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 28px -16px rgba(31, 58, 28, 0.18);
  }

  .journey-step-tile svg.dog-icon {
    width: 84px;
    height: 84px;
    stroke: #1f3a1c;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .journey-step-tile img {
    width: 84px;
    height: 84px;
    object-fit: contain;
  }

  .paw-cluster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .journey-step-label {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    margin-bottom: 6px;
  }

  .journey-step-body {
    font-style: italic;
    font-weight: 400;
    font-size: 15.5px;
    line-height: 1.4;
    color: #2a2a2a;
    max-width: 240px;
    margin: 0 auto;
  }

  /* ===== MOBILE ===== */
  .journey-timeline-mobile { display: none; }

  @media (max-width: 880px) {
    .journey-timeline-desktop { display: none; }
    .journey-timeline-mobile {
      display: block;
      position: relative;
      max-width: 420px;
      margin: 0 auto;
    }
  }

  .paw-trail-mobile {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .paw-cluster.m-1,
  .paw-cluster.m-2,
  .paw-cluster.m-3 {
    width: 50%;
    height: auto;
    transform-origin: center center;
  }

  .paw-cluster.m-1 { left: 28%; top: 7%;  transform: rotate(18deg); }
  .paw-cluster.m-2 { left: 29%; top: 46%; transform: scaleX(-1) rotate(26deg); }
  .paw-cluster.m-3 { left: 28%; top: 61%; transform: rotate(18deg); }

  .journey-mobile-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    row-gap: 20px;
    column-gap: 8px;
  }

  .journey-mobile-step { text-align: center; }
  .journey-mobile-step:nth-child(odd)  { grid-column: 1; }
  .journey-mobile-step:nth-child(even) { grid-column: 2; margin-top: 60px; }

  .journey-mobile-step .journey-step-tile {
    width: 108px;
    height: 108px;
    border-radius: 16px;
    margin: 0 auto 12px;
  }

  .journey-mobile-step .journey-step-tile svg.dog-icon,
  .journey-mobile-step .journey-step-tile img {
    width: 70px;
    height: 70px;
  }

  .journey-mobile-step .journey-step-label { font-size: 16px; margin-bottom: 4px; }
  .journey-mobile-step .journey-step-body  { font-size: 13.5px; max-width: 160px; }

  @media (max-width: 480px) {
    .journey-section { padding: 30px 20px 40px; }
    .journey-header   { margin-bottom: 40px; }
    .journey-title    { font-size: 30px; line-height: 1.1; }
  }
</style>

{%- assign s1 = section.blocks[0].settings -%}
