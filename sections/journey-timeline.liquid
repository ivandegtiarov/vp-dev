{% schema %}
{
  "name": "Journey Timeline",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The journey to better years <em>together..</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Here's what 90 days of real joint support looks like."
    },
    {
      "type": "header",
      "content": "Paw clusters — Desktop"
    },
    {
      "type": "image_picker",
      "id": "paw_d1",
      "label": "Desktop paw cluster 1 (cards 1→2)"
    },
    {
      "type": "image_picker",
      "id": "paw_d2",
      "label": "Desktop paw cluster 2 (cards 2→3)"
    },
    {
      "type": "image_picker",
      "id": "paw_d3",
      "label": "Desktop paw cluster 3 (cards 3→4)"
    },
    {
      "type": "header",
      "content": "Paw clusters — Mobile"
    },
    {
      "type": "image_picker",
      "id": "paw_m1",
      "label": "Mobile paw cluster 1 (cards 1→2)"
    },
    {
      "type": "image_picker",
      "id": "paw_m2",
      "label": "Mobile paw cluster 2 (cards 2→3)"
    },
    {
      "type": "image_picker",
      "id": "paw_m3",
      "label": "Mobile paw cluster 3 (cards 3→4)"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
