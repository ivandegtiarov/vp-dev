      "blocks": {
        "accordion_item_cDDNeh": {
          "type": "accordion_item",
          "settings": {
            "title": "How do I give this to my dog?",
            "content": "<p>Add a few drops to their food or water bowl. The serum has a soft taste, so even the fussiest eaters will have no problem with it.</p>"
          }
        },
        "accordion_item_hjfFdp": {
          "type": "accordion_item",
          "settings": {
            "title": "How long until I start seeing results?",
            "content": "<p>Most owners report visible improvement in mobility within 2-4 weeks. Joint support is cumulative, so <strong>results continue to build over time.</strong></p>"
          }
        },
        "accordion_item_MwwJeb": {
          "type": "accordion_item",
          "settings": {
            "title": "What if my dog doesn’t like the taste?",
            "content": "<p>Dogs will generally not be bothered by the soft taste of the serum. But in the rare case that this happens, we’ll issue you a full refund!</p>"
          }
        },
        "accordion_item_XCiczB": {
          "type": "accordion_item",
          "settings": {
            "title": "At what age can my pup start using these?",
            "content": "<p>The serum is suitable for dogs of all ages and breeds. However, we do recommend a minimum age of 3 months or older.</p>"
          }
        },
        "accordion_item_r6nWYM": {
          "type": "accordion_item",
          "settings": {
            "title": "Is this safe for all breeds and ages?",
            "content": "<p>Yes. The formula is vegan, hypoallergenic, and safe for dogs of all breeds and ages. If your dog is on medication, we recommend checking with your vet first.</p>"
          }
        },
        "accordion_item_GNzUnr": {
          "type": "accordion_item",
          "settings": {
            "title": "What if my dog doesn't improve?",
            "content": "<p>We offer a 90-day money-back guarantee. If you don't see a difference, we'll refund you in full.</p>"
          }
        },
        "accordion_item_kWhNyN": {
          "type": "accordion_item",
          "settings": {
            "title": "How is this different from joint chews?",
            "content": "<p>Joint chews are heat-processed, which destroys key ingredients like collagen and hyaluronic acid. Our serum is cold-processed, preserving every active ingredient. It also contains zero fillers, starches, or artificial flavoring.</p>"
          }
        },
        "accordion_item_3x6dBk": {
          "type": "accordion_item",
          "settings": {
            "title": "How long does one bottle last?",
            "content": "<p>One bottle lasts approximately 30 days at the recommended daily dosage.</p>"
