            "page": "",
            "collapsible_tab_style": "ingredients_list",
            "custom_liquid": "<div class=\"instructions-list\">\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%; font-weight: 600;\"><p>Active Ingredient</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%; font-weight: 600;\"><p>Per 15kg+ Serving (2 ml)</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Glucosamine HCl (Fungal Fermentation)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>600 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Methylsulfonylmethane (MSM)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>600 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Chondroitin Sulfate (Non-Animal)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>240 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>PEA (Palmitoylethanolamide)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>160 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Algal Oil (DHA/EPA)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>100 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Boswellia Serrata Extract</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>80 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Sodium Hyaluronate (Hyaluronic Acid)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>30 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Recombinant Collagen Type II</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>40 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Manganese (as Gluconate)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>3 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table instructions-list__table-last\">\n    <span style=\"width: 100%;\">\n      <p>\n        <u>Inactive Ingredients:</u> Organic Vegetable Glycerin, Purified Water, Natural Savory Flavor (Vegan), Citric Acid, Mixed Tocopherols (Vitamin E).\n\n      </p>\n    </span>\n  </div>\n</div>"
