            "icon": "none",
            "content": "",
            "page": "",
            "collapsible_tab_style": "ingredients_list",
            "custom_liquid": "<div class=\"instructions-list\">\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%; font-weight: 600;\"><p>Active Ingredient</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%; font-weight: 600;\"><p>Quantity (Per 2.5g chew)</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Glucosamine HCl (shrimp and crab)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>200 MG</p></span>\n    </div>\n  </div>\n\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Methylsulfonylmethane (MSM)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>100 MG</p></span>\n    </div>\n  </div>\n\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Total Microorganisms (Probiotics): Lactobacillus plantarum (DSM 9843), Bacillus subtilis (DSM 15544), Enterococcus faecium (NCIMB 10415)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>500M CFU</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Wild Alaskan Salmon Oil</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>95 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Coconut Oil</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>95 MG</p></span>\n    </div>\n  </div>\n\n    <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Pumpkin Powder</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>200 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin A</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>1000 IU</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Natural Vitamin E</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>4 IU</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin B2 (Riboflavin)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>1 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin B6 (Pyridoxine)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>1 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin B9 (Folic Acid)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>0.22 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin B12 (Methylcobalamin)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>0.005 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin D3</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>0.002 MG</p></span>\n    </div>\n  </div>\n\n    <div class=\"instructions-list__table\">\n    <div class=\"instructions-list__left\">\n      <span style=\"width: 100%;\"><p>Vitamin C (Ascorbic Acid)</p></span>\n    </div>\n    <div class=\"instructions-list__right\">\n      <span style=\"width: 100%;\"><p>20 MG</p></span>\n    </div>\n  </div>\n\n  <div class=\"instructions-list__table instructions-list__table-last\">\n    <span style=\"width: 100%;\">\n      <p>\n        <u>Inactive Ingredients:</u> Duck, brewers yeast, coconut glycerin, natural hickory smoke flavour, rosemary extract, sunflower lecithin, tapioca.\n      </p>\n    </span>\n  </div>\n</div>"
