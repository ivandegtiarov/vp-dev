    "ss_testimonial_12_JfmRUx": {
      "type": "ss-testimonial-12",
      "blocks": {
        "slide_Hcfwpb": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "image": "shopify://shop_images/vp-testimonial-customer.webp",
            "video_url": "",
            "controls": false,
            "stars_count": 5,
            "text": "<p>\"Saw this brand on instagram, didn't expect much, but it has worked wonders for my kelpie's gut, loose stools and grass eating is way less now! Happy customer ☺️\"</p>",
            "author": "<p><strong>- Charli</strong></p>"
