            "video_url": "",
            "controls": false,
            "stars_count": 5,
            "text": "<p>\"A friend recommended this brand, and WOW. Within weeks, she was soft, shiny, and even smelled fresher. I will never let us run out of these.\"</p>",
            "author": "<p><strong>- Léa</strong></p>"
          }
        },
        "slide_nDrK9b": {
          "type": "slide",
          "settings": {
