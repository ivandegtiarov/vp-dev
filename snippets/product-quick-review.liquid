{% if block.settings.vet_profile_picture != blank and block.settings.vet_review != blank and block.settings.vet_name != blank %}
  <div class="product-quick-review">
    <div style="width:100%;height:100%">
      <div style="display: flex; align-items: flex-start; margin-bottom: -5px;">
        {% if block.settings.vet_profile_picture %}
          <img
            src="{{ block.settings.vet_profile_picture | image_url: width: 600 }}"
            alt="{{ block.settings.vet_profile_picture.alt }}"
            style="width: 60px; height: 60px; border-radius: 50%; margin-right: 10px;"
            width="60"
            height="60"
            loading="lazy"
          >
        {% endif %}
        <div>
          {% if block.settings.vet_review != blank %}
            <p style="letter-spacing: normal; font-style: italic; font-weight: 500; line-height: normal; font-size: 14px; color: black; margin: 0;">
              "{{ block.settings.vet_review }}"
            </p>
          {% endif %}
          {% if block.settings.vet_name != blank %}
            <p style="font-size: 14px; color: #555; margin: 0;">- {{ block.settings.vet_name }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}
