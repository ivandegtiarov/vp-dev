{% comment %}
  ============================================================================
  VP2 - Variant Picker  (block type: vp_variant_picker)  — snippet
  ----------------------------------------------------------------------------
  VISUAL: pixel-identical to the NATIVE Dawn size pill picker on this template
  (it REUSES the native classes: product-form__input--pill / --pill-dot /
  --pill-image / --pill-title / --pill-price, whose CSS already loads via
  section-main-product.css + component-product-variant-picker.css). No visual
  duplication — same styles, same "Most Popular / Best Value" ::after ribbons.

  LOGIC: the VP - Product Hero self-contained model, NOT the native one:
    - One radio per WHOLE variant (bundle), NOT per option.
    - On change our JS writes the variant id into the shared hidden name="id"
      input — NO Section Rendering re-render, NO ?variant= URL rewrite.
    - Pre-selection (auto / 1 / 2 / 3) with sold-out fallback, honouring
      Shopify's ?variant= in auto mode — identical to the hero.
    - subs / one-time pricing toggled by the section-level class the
      vp_buy_buttons block sets (vp2-single_purchase_option).

  PAIR WITH: snippet 'vp2-buy-buttons' (block vp_buy_buttons), which opens
  <product-form id="vp2-product-form-{{ section.id }}">. These radios attach to
  it via form="…" and share data-vp2-group="{{ section.id }}"; the buy block's
  JS wires them up. Radios are given the native classes/attrs the JS needs.

  NOTE: to avoid triggering Dawn's product-info.js (which owns native
  <variant-selects> and would re-render + rewrite the URL), we DELIBERATELY do
  NOT wrap these in <variant-selects>. We reuse only the presentational classes.
  ============================================================================
{% endcomment %}

{%- liquid
  assign vp2_form_id = 'vp2-product-form-' | append: section.id
  assign opt = product.options_with_values | first
-%}

<style>
  #shopify-section-{{ section.id }} .vp2-pill-picker { display: block; }
  #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .vp2-pill-picker input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  /* subs / one-time pricing toggle (matches native subs-purchase-pricings, but
     namespaced so it's driven only by our block's class, never native JS). */
  #shopify-section-{{ section.id }} .vp2-pill-picker [vp2-single-purchase-pricings] { display: none; }
  #shopify-section-{{ section.id }}.vp2-single_purchase_option .vp2-pill-picker [vp2-subs-purchase-pricings] { display: none !important; }
  #shopify-section-{{ section.id }}.vp2-single_purchase_option .vp2-pill-picker [vp2-single-purchase-pricings] { display: block !important; }



  {%- if hide_badges -%}
  {%- comment -%}
    Hide the "% OFF!" badges ALWAYS in this section. A plain class rule loses to
    the one-time toggle above (`…vp2-single_purchase_option … [vp2-single-purchase-pricings]
    { display:block !important }`), so the single-purchase badge reappeared in
    one-time mode. We give the badges a unique `vp2-pct-hidden` class and hide it
    with rules specific enough to win in BOTH subscribe and one-time modes.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .vp2-pill-picker .vp2-pct-hidden,
  #shopify-section-{{ section.id }}.vp2-single_purchase_option .vp2-pill-picker .vp2-pct-hidden[vp2-single-purchase-pricings],
  #shopify-section-{{ section.id }}.vp2-single_purchase_option .vp2-pill-picker .vp2-pct-hidden[vp2-subs-purchase-pricings] {
    display: none !important;
  }
  #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input-size-2::after,
  #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input-size-3::after {
    content: none !important;
    display: none !important;
  }

  {%- comment -%} Featured-section mobile pill type scale (this section only). {%- endcomment -%}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input--pill-title-text {
      font-size: 17px;
    }
    #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input-size-2::after,
    #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input-size-3::after {
      font-size: 13px;
    }
    #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input--pill-title-text-desc {
      font-size: 14px;
    }
    #shopify-section-{{ section.id }} .vp2-pill-picker .product-form__input--pill-title-text-price-current {
      font-size: 18px;
    }
  }
  {%- endif -%}
</style>

<div class="vp2-pill-picker" data-vp2-group="{{ section.id }}" {{ block.shopify_attributes }}>
  {%- unless product.has_only_default_variant -%}
    <fieldset class="js product-form__input product-form__input--pill product-form__input-size">
      <legend class="form__label">
        {%- if block.settings.option_label != blank -%}
          {{ block.settings.option_label }}:
        {%- else -%}
          {{ opt.name }}:
        {%- endif -%}
      </legend>


      {%- liquid
        assign preselect_option = block.settings.preselect_option | default: 'auto'
        assign value_count = opt.values | size

        assign has_shopify_selected = false
        if preselect_option == 'auto'
          for value in opt.values
            if value.selected
              assign has_shopify_selected = true
              break
            endif
          endfor
        endif

        assign target_idx = 0
        if preselect_option != 'auto'
          assign target_idx = preselect_option | times: 1
          if target_idx > value_count
            assign target_idx = 0
          endif
        endif

        if target_idx > 0
          assign target_pos = target_idx | minus: 1
          assign target_value = opt.values[target_pos]
          unless target_value.available
            assign target_idx = 0
          endunless
        endif

        if target_idx == 0 and has_shopify_selected == false
          for value in opt.values
            if value.available
              assign target_idx = forloop.index
              break
            endif
          endfor
        endif

        assign price_suffix = block.settings.price_suffix | default: '/jar'

        if hide_price_suffix
          assign price_suffix = ''
        endif
      -%}

      {%- for value in opt.values -%}
        {%- liquid
          assign v = value.variant
          assign input_id = section.id | append: '-vp2-' | append: forloop.index0
          assign idx = forloop.index

          assign is_checked = false
          if preselect_option == 'auto' and value.selected
            assign is_checked = true
          elsif idx == target_idx
            assign is_checked = true
          endif

          assign jar_count = v.title | split: ' ' | first | times: 1
          if jar_count < 1
            assign jar_count = 1
          endif
          assign freq_days = jar_count | times: 30
          assign freq_label = freq_days | append: ' days'


          if freq_by_position
            if idx == 1
              assign freq_label = '30 days'
            else
              assign freq_months = idx | times: 2 | minus: 1
              assign freq_label = freq_months | append: ' months'
            endif
          endif

          assign jar_image = block.settings.bundle_image_override
          if jar_image == blank
            assign jar_image = v.metafields.custom.size_featured_image
          endif
        -%}
        <input
          type="radio"
          id="{{ input_id }}"
          name="vp2-bundle-{{ section.id }}"
          value="{{ value | escape }}"
          form="{{ vp2_form_id }}"
          data-vp2-bundle-input
          data-vp2-group="{{ section.id }}"
          data-vp2-variant-id="{{ v.id }}"
          data-vp2-featured-media="{{ v.featured_media.id }}"
          data-vp2-freq="{{ freq_label }}"
          {% if is_checked %}checked{% endif %}
          {% unless value.available %}class="disabled"{% endunless %}
        >
        <label for="{{ input_id }}" class="product-form__input-size-{{ idx }}">
          <span class="product-form__input--pill-dot">
            <span class="product-form__input--pill-dot-inner"></span>
          </span>
          {%- if block.settings.show_jars and jar_image != blank -%}
            <img class="product-form__input--pill-image" src="{{ jar_image | image_url: width: 200 }}" alt="{{ value | escape }}" width="50" height="50">
          {%- endif -%}
          <div class="product-form__input--pill-title">
            <div class="product-form__input--pill-title-text">{{- value -}}</div>
            {%- if v.metafields.custom.size_jar_chews_count != blank -%}
              <div class="product-form__input--pill-title-text-desc">{{ v.metafields.custom.size_jar_chews_count }}</div>
            {%- endif -%}
          </div>
          {%- if v.metafields.custom.size_jar_discount_value != blank -%}
            <div class="product-form__input--pill-percentages{% if hide_badges %} vp2-pct-hidden{% endif %}" vp2-subs-purchase-pricings>{{ v.metafields.custom.size_jar_discount_value }}% OFF!</div>
          {%- endif -%}
          {%- if v.metafields.custom.size_jar_dicount_value_one_time_purchase != blank -%}
            <div class="product-form__input--pill-percentages{% if hide_badges %} vp2-pct-hidden{% endif %}" vp2-single-purchase-pricings>{{ v.metafields.custom.size_jar_dicount_value_one_time_purchase }}% OFF!</div>
          {%- endif -%}
          <div class="product-form__input--pill-price">
            <div class="product-form__input--pill-title-text-price-compare">{{ product.variants[0].compare_at_price | money }}{{ price_suffix }}</div>
            <div class="product-form__input--pill-title-text-price-current" vp2-subs-purchase-pricings>{{ v.metafields.custom.single_jar_price.value | money }}{{ price_suffix }}</div>
            <div class="product-form__input--pill-title-text-price-current" vp2-single-purchase-pricings>{{ v.metafields.custom.single_jar_price_one_time_purchase.value | money }}{{ price_suffix }}</div>
          </div>
          {%- unless value.available -%}
            <span class="visually-hidden label-unavailable">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
          {%- endunless -%}
        </label>
      {%- endfor -%}
    </fieldset>
  {%- endunless -%}
</div>
