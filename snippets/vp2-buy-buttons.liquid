{% comment %}
  ============================================================================
  VP2 - Buy Buttons  (block type: vp_buy_buttons)  — snippet
  ----------------------------------------------------------------------------
  VISUAL: pixel-identical to the NATIVE Dawn buy button on this template. It
  REUSES the native classes (product-form__submit button button--full-width
  button--primary / product-form__submit-text-atc / product-form__price-wrapper-
  b-plus / product-form__price-sale / product-form__price-regular), whose CSS
  already loads via section-main-product.css. No visual duplication.

  LOGIC: the VP - Product Hero self-contained model, NOT the native one:
    - Owns the hidden <product-form id="vp2-product-form-{{ section.id }}"> that
      the SEPARATE vp_variant_picker block's radios attach to (form="…").
    - On bundle change our JS writes the variant id into name="id" — NO Section
      Rendering re-render, NO ?variant= URL rewrite.
    - Subscribe checkbox is a PROXY for the Loop app widget (clicks Loop's
      selling-plan group / one-time option; toggles the pricing class).
    - ATC price rows are server-rendered per variant from metafields; only the
      pre-selected one is visible on first paint (no flash). JS swaps on change.

  COORDINATION: shared form id + data-vp2-group="{{ section.id }}". The subs /
  one-time toggle is a class on the SECTION wrapper (vp2-single_purchase_option)
  so BOTH blocks' prices switch together.
  ============================================================================
{% endcomment %}

{%- liquid
  assign vp2_form_id = 'vp2-product-form-' | append: section.id

  # Resolve the pre-selected variant the SAME way the picker snippet does, so the
  # server-rendered ATC price matches the checked pill. Duplicated (not shared)
  # because Liquid renders snippets in isolation.
  assign opt = product.options_with_values | first
  assign value_count = opt.values | size
  assign preselect_option = block.settings.preselect_option | default: 'auto'

  assign has_shopify_selected = false
  if preselect_option == 'auto'
    for value in opt.values
      if value.selected
        assign has_shopify_selected = true
        break
      endif
    endfor
  endif

  assign target_idx = 0
  if preselect_option != 'auto'
    assign target_idx = preselect_option | times: 1
    if target_idx > value_count
      assign target_idx = 0
    endif
  endif

  if target_idx > 0
    assign target_pos = target_idx | minus: 1
    assign target_value = opt.values[target_pos]
    unless target_value.available
      assign target_idx = 0
    endunless
  endif

  if target_idx == 0 and has_shopify_selected == false
    for value in opt.values
      if value.available
        assign target_idx = forloop.index
        break
      endif
    endfor
  endif

  assign vp2_selected_variant_id = 0
  for value in opt.values
    assign v = value.variant
    assign is_checked = false
    if preselect_option == 'auto' and value.selected
      assign is_checked = true
    elsif forloop.index == target_idx
      assign is_checked = true
    endif
    if is_checked
      assign vp2_selected_variant_id = v.id
    endif
  endfor

  assign vp2_initial_variant_id = vp2_selected_variant_id | default: product.selected_or_first_available_variant.id
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  /* Namespaced helpers only. The button + price styling comes from the native
     classes already loaded by section-main-product.css. */
  #shopify-section-{{ section.id }} .vp2-buy { display: block; }

  /* ATC button lays out as: [ CTA text ][ price group ] centered on one row. */
  #shopify-section-{{ section.id }} .vp2-buy .product-form__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .vp2-buy .product-form__submit-text-atc { display: inline-flex; }

  /* Show only the selected variant's ATC price row; align its parts inline. */
  #shopify-section-{{ section.id }} .vp2-buy .product-form__price-wrapper-b-plus { display: inline-flex; align-items: center; }
  #shopify-section-{{ section.id }} .vp2-buy .product-form__price-wrapper-b-plus-inner { display: none; }
  #shopify-section-{{ section.id }} .vp2-buy .product-form__price-wrapper-b-plus-inner.vp2-active {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .vp2-buy .product-form__price-wrapper-b-plus-inner .product-form__price-sale { font-size: 20px; font-weight: 700; line-height: 1; }
  #shopify-section-{{ section.id }} .vp2-buy .product-form__price-wrapper-b-plus-inner .product-form__price-regular { line-height: 1; }

  /* subs / one-time toggle — class lives on the section wrapper so the picker
     block's prices switch in lockstep. */
  #shopify-section-{{ section.id }} .vp2-buy [vp2-single-purchase-pricings] { display: none; }
  #shopify-section-{{ section.id }}.vp2-single_purchase_option .vp2-buy [vp2-subs-purchase-pricings] { display: none !important; }
  #shopify-section-{{ section.id }}.vp2-single_purchase_option .vp2-buy [vp2-single-purchase-pricings] { display: inline !important; }

  /* ---- SUBSCRIBE CARD — copied from the initial setup (.auto-refill) ---- */
  #shopify-section-{{ section.id }} .vp2-auto-refill {
    display: flex;
    background-color: #f8f8f8;
    align-items: center;
    padding: 10px 15px;
    border: 1px dashed #b9b9b9;
    border-radius: 4px;
    margin-top: 2rem;
    margin-bottom: 1.5rem;
  }
  #shopify-section-{{ section.id }} .vp2-auto-refill input[type="checkbox"] {
    -webkit-appearance: none; -moz-appearance: none; appearance: none;
    width: 25px; height: 25px;
    border: 2px solid #7BBC72FF; border-radius: 4px;
    margin: 0; outline: none; cursor: pointer; background: #fff;
    flex-shrink: 0; position: relative;
  }
  #shopify-section-{{ section.id }} .vp2-auto-refill input[type="checkbox"]:checked { background-color: #7BBC72FF; }
  #shopify-section-{{ section.id }} .vp2-auto-refill input[type="checkbox"]:checked::after {
    content: '✓'; font-size: 14px; color: #fff;
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    font-family: sans-serif;
  }
  #shopify-section-{{ section.id }} .vp2-auto-refill label {
    display: flex; flex-direction: column; cursor: pointer; gap: 2px; padding-left: 12px;
  }
  #shopify-section-{{ section.id }} .vp2-auto-refill-title { margin: 0; line-height: 1; font-size: 15px; font-weight: 700; color: #000; }
  #shopify-section-{{ section.id }} .vp2-subs-content { display: flex; gap: 8px; align-items: center; justify-content: flex-start; }
  #shopify-section-{{ section.id }} .vp2-subs-content .vp2-subs-icons { font-style: italic; display: flex; align-items: center; gap: 6px; }
  #shopify-section-{{ section.id }} .vp2-subs-content .vp2-subs-icons p { margin: 0; }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .vp2-auto-refill { margin-top: 2rem; padding: 12px; }
    #shopify-section-{{ section.id }} .vp2-auto-refill-title { font-size: 15px; }
    #shopify-section-{{ section.id }} .vp2-subs-content .vp2-subs-icons { font-size: 12px; }
  }
</style>

<div class="vp2-buy product-form-main-container" data-vp2-group="{{ section.id }}" {{ block.shopify_attributes }}>
  <product-form class="product-form" data-section-id="{{ section.id }}">
    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
      <span class="product-form__error-message"></span>
    </div>

    {%- form 'product', product, id: vp2_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ vp2_initial_variant_id }}" class="vp2-variant-id">

      {%- comment -%}
        SUBSCRIBE CARD — Loop proxy (see header comment). Optional via setting.
      {%- endcomment -%}
      {%- if block.settings.show_subscribe -%}
        <div class="vp2-auto-refill">
          <input type="checkbox" id="vp2-auto_refill-{{ section.id }}" name="vp2-auto-refill" data-vp2-auto-refill checked>
          <label for="vp2-auto_refill-{{ section.id }}">
            <p class="vp2-auto-refill-title">{{ block.settings.subscribe_title | default: 'Subscribe for an extra 20% off' }}</p>
            <div class="vp2-subs-content">
              <div class="vp2-subs-icons">
                {%- if block.settings.subscribe_icon_1 -%}
                  <img src="{{ block.settings.subscribe_icon_1 | image_url: width: 50 }}" alt="Fast delivery" width="20" height="20">
                {%- else -%}
                  <img src="https://cdn.shopify.com/s/files/1/0856/4110/1578/files/fast-delivery.png?v=1733337974&width=50" alt="Fast delivery" width="20" height="20">
                {%- endif -%}
                <p>Shipped every <span class="vp2-freq-label">{{ block.settings.subscribe_frequency_label | default: '30 days' }}</span></p>
              </div>
              <div class="vp2-subs-icons">
                {%- if block.settings.subscribe_icon_2 -%}
                  <img src="{{ block.settings.subscribe_icon_2 | image_url: width: 50 }}" alt="Cancel anytime" width="20" height="20">
                {%- else -%}
                  <img src="https://cdn.shopify.com/s/files/1/0856/4110/1578/files/pause.png?v=1733337974&width=50" alt="Cancel anytime" width="20" height="20">
                {%- endif -%}
                <p>Cancel/adjust anytime</p>
              </div>
            </div>
          </label>
        </div>
      {%- endif -%}

      {%- comment -%} Fallback Loop mount target. {%- endcomment -%}
      <div class="vp2-loop-target" data-vp2-loop-target hidden></div>

      <div class="product-form__buttons">
        <button
          id="vp2-ProductSubmitButton-{{ section.id }}"
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
        >
          {%- comment -%}
            First span = ONLY the CTA text: product-form.js overwrites the first
            <span>'s textContent, so prices must live in a SEPARATE sibling span.
          {%- endcomment -%}
          <span class="product-form__submit-text-atc">{{ block.settings.atc_text | default: 'ADD TO CART' }}</span>

          <span class="product-form__price-wrapper-b-plus vp2-atc-prices">
            {%- for v in product.variants -%}
              <div
                class="product-form__price-wrapper-b-plus-inner vp2-price-row{% if v.id == vp2_initial_variant_id %} vp2-active{% endif %}"
                data-vp2-variant-prices="{{ v.id }}"
              >
                <span class="product-form__price-sale" vp2-subs-purchase-pricings>
                  {%- if v.metafields.custom.single_jar_price_subscription_full_price.value != blank -%}
                    {{ v.metafields.custom.single_jar_price_subscription_full_price.value | money }}
                  {%- else -%}
                    {{ v.metafields.custom.single_jar_price.value | money }}
                  {%- endif -%}
                </span>
                <span class="product-form__price-sale" vp2-single-purchase-pricings>
                  {%- if v.metafields.custom.single_jar_price_subscription_full_price.value != blank -%}
                    {{ v.price | money }}
                  {%- else -%}
                    {{ v.metafields.custom.single_jar_price_one_time_purchase.value | money }}
                  {%- endif -%}
                </span>
                <span class="product-form__price-regular">{{ v.compare_at_price | money }}</span>
              </div>
            {%- endfor -%}
          </span>
          {%- render 'loading-spinner' -%}
        </button>
      </div>
    {%- endform -%}
  </product-form>

  {%- if block.settings.label != blank -%}
    <div class="product__buy-buttons-label">
      {% render 'checkmark-yes' %}
      {{ block.settings.label }}
    </div>
  {%- endif -%}
</div>

<script defer="defer">
  (function () {
    var SECTION_ID = '{{ section.id }}';
    var FORM_ID = '{{ vp2_form_id }}';
    var section = document.getElementById('shopify-section-' + SECTION_ID);
    var group = section && section.querySelector('.vp2-buy[data-vp2-group="' + SECTION_ID + '"]');
    if (!section || !group) return;

    var form = document.getElementById(FORM_ID);
    var variantIdInput = section.querySelector('.vp2-variant-id');
    var bundleInputs = section.querySelectorAll('[data-vp2-bundle-input][data-vp2-group="' + SECTION_ID + '"]');

    function showVariantPrice(variantId) {
      section.querySelectorAll('[data-vp2-variant-prices]').forEach(function (row) {
        if (row.getAttribute('data-vp2-variant-prices') === String(variantId)) {
          row.classList.add('vp2-active');
        } else {
          row.classList.remove('vp2-active');
        }
      });
    }
    function slideToMedia(mediaId) {
      if (!mediaId) return;
      var main = window['vpMainSwiper_' + SECTION_ID];   // reuse gallery swiper if present
      if (!main) return;
      var slides = main.slides;
      for (var i = 0; i < slides.length; i++) {
        if (slides[i].getAttribute('data-media-id') === String(mediaId)) { main.slideTo(i); break; }
      }
    }

    /* ---------- SUBSCRIPTION (Loop widget proxy) ---------- */
    var autoRefill = section.querySelector('[data-vp2-auto-refill]');

    function loopOnetimeEl() {
      return (form && form.querySelector('.loop-widget-purchase-option-onetime'))
        || document.querySelector('.loop-widget-purchase-option-onetime');
    }
    function loopSubEl() {
      return (form && form.querySelector('[data-loop-widget-selling-plan-group]'))
        || document.querySelector('[data-loop-widget-selling-plan-group]');
    }
    function isSubscribed() { return autoRefill ? autoRefill.checked : false; }

    function setPriceMode() {
      if (!autoRefill) { section.classList.add('vp2-single_purchase_option'); return; }
      if (isSubscribed()) {
        section.classList.remove('vp2-single_purchase_option');
      } else {
        section.classList.add('vp2-single_purchase_option');
      }
    }
    function syncLoopWidget() {
      var subEl = loopSubEl();
      var oneEl = loopOnetimeEl();
      if (isSubscribed()) {
        if (subEl) subEl.click();
      } else {
        if (oneEl) oneEl.click();
      }
    }
    function applyPurchaseMode() { setPriceMode(); syncLoopWidget(); }
    function watchLoopWidget() {
      if (loopOnetimeEl() && loopSubEl()) { syncLoopWidget(); return; }
      var obs = new MutationObserver(function () {
        if (loopOnetimeEl() && loopSubEl()) { syncLoopWidget(); obs.disconnect(); }
      });
      obs.observe(document.body, { childList: true, subtree: true });
    }

    /* Subscribe frequency follows the picked bundle (data-vp2-freq). */
    var freqLabels = section.querySelectorAll('.vp2-freq-label');
    function setFreqLabel(input) {
      var freq = input && input.getAttribute('data-vp2-freq');
      if (!freq) return;
      freqLabels.forEach(function (el) { el.textContent = freq; });
    }

    function selectVariant(input) {
      var id = input.getAttribute('data-vp2-variant-id');
      if (variantIdInput) variantIdInput.value = id;
      window.currenSelectedVariantId = id;
      showVariantPrice(id);
      slideToMedia(input.getAttribute('data-vp2-featured-media'));
      setFreqLabel(input);
      setPriceMode();
      syncLoopWidget();
    }
    bundleInputs.forEach(function (input) {
      input.addEventListener('change', function () { if (input.checked) selectVariant(input); });
    });

    if (autoRefill) autoRefill.addEventListener('change', applyPurchaseMode);

    /* initialise from the checked bundle */
    var checked = section.querySelector('[data-vp2-bundle-input][data-vp2-group="' + SECTION_ID + '"]:checked');
    if (checked) {
      var cid = checked.getAttribute('data-vp2-variant-id');
      if (variantIdInput) variantIdInput.value = cid;
      window.currenSelectedVariantId = cid;
      showVariantPrice(cid);
      slideToMedia(checked.getAttribute('data-vp2-featured-media'));
      setFreqLabel(checked);
    }
    setPriceMode();
    watchLoopWidget();
  })();
</script>
