      gap: 8px;
    }

    .product__info-wrapper.single_purchase_option .product-form__price-wrapper-b-plus-{{product.selected_or_first_available_variant.id}} span[single-purchase-pricings] {
      display: flex !important;
    }

  </style>


  {% if template.suffix == 'd-test-advance-new' and product.id == 10314483138826 %}
    <script defer="defer">
      (function() {
          const currentSelectedVariant = '{{ product.selected_or_first_available_variant.id }}';
          window.currenSelectedVariantId = currentSelectedVariant || null;
          const autoRefillCheckbox = document.querySelector('#auto_refill');
          const variantPlanMap = {
            "52152451957002": "5815730442",
            "52152451989770": "5815763210",
            "52152452022538": "5815795978",
          };

          if(currentSelectedVariant == '52152451957002') {
            document.querySelector('.auto-refill-frequency-time').textContent = 'month';
          } else if(currentSelectedVariant == '52152451989770') {
            document.querySelector('.auto-refill-frequency-time').textContent = '2 months';
          } else if(currentSelectedVariant == '52152452022538') {
            document.querySelector('.auto-refill-frequency-time').textContent = '3 months';
          }

          if (variantPlanMap[currentSelectedVariant] && autoRefillCheckbox.checked) {
            const waitForSelect = setInterval(() => {
              const freq = document.querySelector('#frequency');
              if (freq) {
                clearInterval(waitForSelect);
                freq.value = variantPlanMap[currentSelectedVariant];
                freq.dispatchEvent(new Event('change'));
              }
            }, 300);
          }
        })();
    </script>
  {% endif %}

