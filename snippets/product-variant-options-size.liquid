{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign swatch_focal_point = null
    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {%- if picker_type == 'swatch' -%}
    {%- capture help_text -%}
      <span class="visually-hidden">{{ value | escape }}</span>
      {{ label_unavailable }}
    {%- endcapture -%}
    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: value | escape,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}

  {%- elsif picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ value | escape }}"
      form="{{ product_form_id }}"
      {% if value.selected %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
      {% endif %}
      {{ input_dataset }}
    >
    <label for="{{ input_id }}" class="product-form__input-size-{{forloop.index}}{% if product.id == 10494982750474 %} featured-label-design{% endif %}">
      <span class="product-form__input--pill-dot">
        <span class="product-form__input--pill-dot-inner"></span>
      </span>
      <img class="product-form__input--pill-image" src="{{ value.variant.metafields.custom.size_featured_image.value | image_url: width: 200 }}" alt="{{ value | escape }}" width="50" height="50">
      <div class="product-form__input--pill-title">
        <div class="product-form__input--pill-title-text">{{- value -}}
          {% if product.id == 10494982750474 %}
            <div class="product-form__input--pill-percentages" subs-purchase-pricings>
              {{- value.variant.metafields.custom.size_jar_discount_value.value }}% OFF!
            </div>
            <div class="product-form__input--pill-percentages" single-purchase-pricings>
              {{- value.variant.metafields.custom.size_jar_dicount_value_one_time_purchase.value }}% OFF!
            </div>
          {% endif %}
        </div>
        <div class="product-form__input--pill-title-text-desc">{{ value.variant.metafields.custom.size_jar_chews_count.value }}
          {% if product.metafields.custom.enable_serum_per_day_price == true %}
            {% if localization.country.iso_code == 'US' %}
              {% assign price_1 = '$1,4/day' %}
              {% assign price_2 = '$1,1/day' %}
              {% assign price_3 = '$0,8/day' %}
            {% elsif localization.country.iso_code == 'NZ' %}
              {% assign price_1 = '$2,3/day' %}
              {% assign price_2 = '$1,8/day' %}
              {% assign price_3 = '$1,4/day' %}
            {% elsif localization.country.iso_code == 'AU' %}
              {% assign price_1 = '$1,9/day' %}
              {% assign price_2 = '$1,5/day' %}
              {% assign price_3 = '$1,1/day' %}
            {% elsif localization.country.iso_code == 'GB' %}
              {% assign price_1 = '£1,01/day' %}
              {% assign price_2 = '£0,82/day' %}
              {% assign price_3 = '£0,63/day' %}
            {% else %}
              {% assign price_1 = '€1,17/day' %}
              {% assign price_2 = '€0,95/day' %}
              {% assign price_3 = '€0,73/day' %}
            {% endif %}

            {% if value.variant.id == 52985927729418 or value.variant.id == 52985927827722 %}
              <span class="product-form__input--pill-title-text-desc-price">({{ price_1 }})</span>
            {% elsif value.variant.id == 52985927762186 or value.variant.id == 52985927860490 %}
                <span class="product-form__input--pill-title-text-desc-price">({{ price_2 }})</span>
            {% elsif value.variant.id == 52985927794954 or value.variant.id == 52985927893258 %}
                <span class="product-form__input--pill-title-text-desc-price">({{ price_3 }})</span>
            {% endif %}
          {% endif %}
        </div>
      </div>
      <div class="product-form__input--pill-percentages product-form__input--pill-percentages-featured-label-design" subs-purchase-pricings>
        {{- value.variant.metafields.custom.size_jar_discount_value.value }}% OFF!
      </div>
      <div class="product-form__input--pill-percentages product-form__input--pill-percentages-featured-label-design" single-purchase-pricings>
        {{- value.variant.metafields.custom.size_jar_dicount_value_one_time_purchase.value }}% OFF!
      </div>

      {% unless template.suffix == 'serum' or template.suffix == 'serum-b' %}
         {% assign text = '/jar' %}
        {% else %}
          {% assign text = '/pc' %}
      {% endunless %}

      <div class="product-form__input--pill-price">
        {% if product.id == 10546921439498 %}
          <div class="product-form__input--pill-title-text-price-compare"> {{ value.variant.compare_at_price | money }}</div>
          {% assign text = '' %}
          {% else %}
          <div class="product-form__input--pill-title-text-price-compare"> {{ product.variants[0].compare_at_price | money }}{{ text }}</div>
        {% endif %}
        <div class="product-form__input--pill-title-text-price-current" subs-purchase-pricings>{{ value.variant.metafields.custom.single_jar_price.value | money }}{{ text }}</div>
        <div class="product-form__input--pill-title-text-price-current" single-purchase-pricings>{{ value.variant.metafields.custom.single_jar_price_one_time_purchase.value | money }}{{ text }}</div>
      </div>
      {{ label_unavailable }}
    </label>
  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}
    <option
      id="{{ input_id }}"
      value="{{ value | escape }}"
      {% if value.selected %}
        selected="selected"
      {% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}


{% if request.page_type == 'product' and template.suffix == 'b-test-advanced-plus' or request.page_type == 'product' and template.suffix == 'd-test-advance' or request.page_type == 'product' and template.suffix == 'b-test-advanced-dosage' or request.page_type == 'product' and template.suffix == 'd-test-advance-new' or request.page_type == 'product' and template.suffix == 'serum' or request.page_type == 'product' and template.suffix == 'd-test-advance-newest' or request.page_type == 'product' and template.suffix == 'e-new' or request.page_type == 'product' and template.suffix == 'serum-b' or template.suffix == 'd-test-with-5-option' %}
