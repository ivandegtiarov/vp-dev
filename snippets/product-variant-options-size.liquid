{% if request.page_type == 'product' and template.suffix == 'b-test-advanced-plus' or request.page_type == 'product' and template.suffix == 'd-test-advance' or request.page_type == 'product' and template.suffix == 'b-test-advanced-dosage' or request.page_type == 'product' and template.suffix == 'd-test-advance-new' or request.page_type == 'product' and template.suffix == 'serum' or request.page_type == 'product' and template.suffix == 'd-test-advance-newest' or request.page_type == 'product' and template.suffix == 'e-new' or request.page_type == 'product' and template.suffix == 'serum-b' or template.suffix == 'd-test-with-5-option' %}
  <style>
    .product-form__input-size input[type=radio] + label:focus-visible{
      outline: 0 !important;
      box-shadow: none !important;
    }

    .product-form__input-size input[type=radio]+label:before  {
      display: none !important;
    }

  </style>
{% endif %}

