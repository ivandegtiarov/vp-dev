<style>
  #appstle_subscription_widget0 {
    opacity: 0;
    height: 0;
    width: 0;
    visibility: hidden;
    overflow: hidden;
  }

  .product-box-modal-label-plus {
    font-size: 16px;
    line-height: 22px;
    color: #000;
    font-weight: 700;
    /* margin-bottom: 15px; */
  }

  .product-box-modal-label-plus-options {
    position: relative;
    padding-top: 10px;
  }

  .product-box-modal-label-plus-options select {
    display: block;
    width: 100%;
    margin: 0;
    border: .1rem solid #000000;
    border-radius: 4px;
    padding: 11px 15px 11px 10px;
    font-size: 14px;
    font-weight: 400;
    outline: 0;
    cursor: pointer;
    background: transparent;
    appearance: none;
    font-style: italic;
    background: #fff url({{ 'arrow-down-black.svg' | asset_url }}) no-repeat center right 1.5rem;
    background-size: 14px;
    color: #000000;
    font-weight: 700;
    box-shadow: none;
    text-shadow: none;
  }

  .free-gifts-ui-container {
    display: block !important;
  }

  .product-form__price-wrapper-b-plus {
    display: flex;
  }

  .product-box-modal-label-plus-delivery-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #f6f6f6;
    border-radius: 4px;
    padding: 10px;
    margin-bottom: 10px;
  }

  .product-box-modal-label-option-icons {
    display: flex;
    row-gap: 8px;
    position: relative;
    max-width: 100%;
    min-width: auto;
    align-self: stretch;
    column-gap: 8px;
    flex-basis: auto;
    min-height: 1px;
    transition: inherit;
    align-items: center;
    flex-shrink: 0;
    justify-content: flex-start;
  }

  .product-box-modal-label-option-icons img {
    object-fit: contain;
  }

  .product-box-modal-label-option-icons p {
    flex-grow: 1;
    font-size: 13px;
    flex-basis: 0;
    text-align: left;
    transition: inherit;
    flex-shrink: 1;
    font-family: Inter, ' sans-serif';
    line-height: 20px;
    overflow-wrap: break-word;
    text-align-last: left;
    color: #000000;
    letter-spacing: 0;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .product-box-modal-label-option-icons p {
      font-size: 12px;
    }

    .product-box-modal-label-option-icons img {
      width: 15px;
      height: 15px;
    }

    .product-box-modal-label-option-icons {
      gap: 4px;
    }

    .custom-content-labels-container {
      margin-top: 0;
    }

    .product-box-modal-label-text-plus {
      font-size: 14px;
    }
  }

  div[single-purchase-pricings],
  span[single-purchase-pricings] {
    display: none;
  }

  .product__info-wrapper.single_purchase_option div[subs-purchase-pricings],
  .product__info-wrapper.single_purchase_option span[subs-purchase-pricings],
  .product__info-wrapper.single_purchase_option .free-gifts-ui-container {
    display: none !important;
  }

  .product__info-wrapper.single_purchase_option div[single-purchase-pricings]{
    display: block !important;
  }

  .product__info-wrapper variant-selects .featured-label-design .product-form__input--pill-percentages-featured-label-design {
    display: none !important;
   }

</style>

{% if product.id == 10306128478474 %}
