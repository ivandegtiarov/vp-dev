<script defer="defer">
  document.addEventListener("DOMContentLoaded", () => {
    function syncValues(fromFrequency = true) {
      const freq = document.querySelector("#frequency");
      const planLabelSub = document.querySelector('#appstle_selling_plan_label_20[name="selling_plan"]');
      const planLabelOneTime = document.querySelector('#appstle_selling_plan_label_10[name="selling_plan"]');
      const mainProductWrapper = document.querySelector('.product__info-wrapper');
      const planSelect = document.querySelector("select#appstle_selling_plan0");
      const widget = document.querySelector("#appstle_subscription_widget0");

      if (!freq || !planLabelSub || !planSelect || !widget) return false;

      const value = fromFrequency ? freq.value : planSelect.value;

      // Keep everything in sync
      freq.value = value;
      planSelect.value = value;
      widget.setAttribute("data-selected-selling-plan", value);

      // --- Handle which radio to click ---
      if (value === "one-time" && planLabelOneTime) {
        planLabelOneTime.click();
        mainProductWrapper.classList.add('single_purchase_option');
      } else {
        planLabelSub.value = value;
        planLabelSub.click();
        mainProductWrapper.classList.remove('single_purchase_option');
      }

      return true;
    }

    // Keep checking until elements are ready
    const initInterval = setInterval(() => {
      if (syncValues()) {
        clearInterval(initInterval);

        // --- Event binding once everything exists ---
        document.querySelector("#frequency").addEventListener("change", () => {
          syncValues(true);
        });

        document.querySelector("select#appstle_selling_plan0").addEventListener("change", () => {
          syncValues(false);
        });
      }
    }, 500);

    // If selling_plan is in URL, wait for elements, then sync
    if (window.location.href.includes("selling_plan")) {
      const urlSync = setInterval(() => {
        if (syncValues(false)) {
          clearInterval(urlSync);
        }
      }, 500);
    }

    // --- Special logic for d-test-advance template ---
    const autoRefill = document.querySelector('#auto_refill');
    const frequencySelect = document.querySelector('#frequency');

    {% if product.id == 10314483138826 %}
      let frequencySelectValue = '5815763210';
    {% elsif product.id == 10316636979466 or product.id == 10396349563146 or product.id == 10443398414602 or product.id == 10478806925578 or product.id == 10490050052362 %}
      let frequencySelectValue = '5822972170';
    {% elsif product.id == 10326775365898 or product.id == 10494982750474 %}
        let frequencySelectValue = '6068371722';
    {% else %}
      const frequencySelectValue = '5075992842';
    {% endif %}

    console.log('frequencySelectValue', frequencySelectValue);

    if (autoRefill && frequencySelect) {
      autoRefill.addEventListener('change', () => {
        console.log('autoRefill changed');

        if(window.currenSelectedVariantId) {
          if(window.currenSelectedVariantId == '52152451957002') {
            frequencySelectValue = '5815730442';
          } else if(window.currenSelectedVariantId == '52152451989770') {
            frequencySelectValue = '5815763210';
          } else if(window.currenSelectedVariantId == '52152452022538') {
            frequencySelectValue = '5815795978';
          }
          else if(window.currenSelectedVariantId == '52162322825482') {
            frequencySelectValue = '5822939402';
          } else if(window.currenSelectedVariantId == '52162322858250') {
            frequencySelectValue = '5822972170';
          } else if(window.currenSelectedVariantId == '52162322891018') {
            frequencySelectValue = '5823004938';
          }
          else if(window.currenSelectedVariantId == '52602279493898') {
            frequencySelectValue = '6068338954';
          } else if(window.currenSelectedVariantId == '52602279526666') {
            frequencySelectValue = '6068371722';
          } else if(window.currenSelectedVariantId == '52602279559434') {
            frequencySelectValue = '6068404490';
          }
          else if(window.currenSelectedVariantId == '52835744809226') {
            frequencySelectValue = '6068338954';
          } else if(window.currenSelectedVariantId == '52835744841994') {
            frequencySelectValue = '6068371722';
          } else if(window.currenSelectedVariantId == '52835744874762') {
            frequencySelectValue = '6068404490';
          }
          else if(window.currenSelectedVariantId == '52720647241994') {
            frequencySelectValue = '5822939402';
          } else if(window.currenSelectedVariantId == '52720647274762') {
            frequencySelectValue = '5822972170';
          } else if(window.currenSelectedVariantId == '52720647307530') {
            frequencySelectValue = '5823004938';
          }
          else if(window.currenSelectedVariantId == '52881813111050') {
            frequencySelectValue = '5822939402';
          } else if(window.currenSelectedVariantId == '52881813143818') {
            frequencySelectValue = '5822972170';
          } else if(window.currenSelectedVariantId == '52881813176586') {
            frequencySelectValue = '5823004938';
          }
          else if(window.currenSelectedVariantId == '52945602674954') {
            frequencySelectValue = '5822939402';
          } else if(window.currenSelectedVariantId == '52945602707722') {
            frequencySelectValue = '5822972170';
          } else if(window.currenSelectedVariantId == '52945602740490') {
            frequencySelectValue = '5823004938';
          }
          else if(window.currenSelectedVariantId == '52985927729418' || window.currenSelectedVariantId == '52985927827722') {
            frequencySelectValue = '6068338954';
          } else if(window.currenSelectedVariantId == '52985927762186' || window.currenSelectedVariantId == '52985927860490') {
            frequencySelectValue = '6068371722';
          } else if(window.currenSelectedVariantId == '52985927794954' || window.currenSelectedVariantId == '52985927893258') {
            frequencySelectValue = '6068404490';
          }
          else {
            frequencySelectValue = '5075992842';
          }
        }

        if (autoRefill.checked) {
          // Checked → Select 30 days plan
          frequencySelect.value = frequencySelectValue; // 30 days plan
        } else {
          // Unchecked → One-time purchase
          frequencySelect.value = 'one-time';
        }
        // Trigger change event so your existing sync logic runs
        frequencySelect.dispatchEvent(new Event('change'));
      });

      // Optional: ensure correct state on load
      if (autoRefill.checked) {
        frequencySelect.value = frequencySelectValue;
      } else {
        frequencySelect.value = 'one-time';
      }
      frequencySelect.dispatchEvent(new Event('change'));
    }
  });
</script>

