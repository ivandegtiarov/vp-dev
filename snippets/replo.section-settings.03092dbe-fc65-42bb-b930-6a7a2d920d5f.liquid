    {%- capture default_replo_text_8a45a934-2180-451b-9c44-d71003024266 -%}<p>What flavour is the Multivitamin?</p>{%- endcapture -%}
    {%- assign replo_text_8a45a934-2180-451b-9c44-d71003024266 = replo_text_8a45a934-2180-451b-9c44-d71003024266 | default: default_replo_text_8a45a934-2180-451b-9c44-d71003024266 -%}
