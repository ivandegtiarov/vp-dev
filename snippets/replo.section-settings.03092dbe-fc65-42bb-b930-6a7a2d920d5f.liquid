    {%- capture default_replo_text_16213426-0851-44ac-9142-acccf6e32302 -%}<p>How long until I start seeing the benefits?</p>{%- endcapture -%}
    {%- assign replo_text_16213426-0851-44ac-9142-acccf6e32302 = replo_text_16213426-0851-44ac-9142-acccf6e32302 | default: default_replo_text_16213426-0851-44ac-9142-acccf6e32302 -%}
