    {%- capture default_replo_text_5f92cd34-5fe8-42be-9886-89b0f86ac8a3 -%}<p>Can I take this dog multivitamin with other supplements? </p>{%- endcapture -%}
    {%- assign replo_text_5f92cd34-5fe8-42be-9886-89b0f86ac8a3 = replo_text_5f92cd34-5fe8-42be-9886-89b0f86ac8a3 | default: default_replo_text_5f92cd34-5fe8-42be-9886-89b0f86ac8a3 -%}
