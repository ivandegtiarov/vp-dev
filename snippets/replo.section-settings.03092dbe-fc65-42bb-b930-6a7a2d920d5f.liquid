    {%- assign replo_text_f6dc1711-e368-4aaf-8c58-2b6be8f0f84d = replo_text_f6dc1711-e368-4aaf-8c58-2b6be8f0f84d | default: default_replo_text_f6dc1711-e368-4aaf-8c58-2b6be8f0f84d -%}
