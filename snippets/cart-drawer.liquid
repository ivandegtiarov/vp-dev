{% if request.page_type == 'product' and template.suffix == 'b-test-advanced' or request.page_type == 'cart' or request.page_type == 'index' or request.page_type == 'collection' %}
  <script defer="defer">
    // const mainItemId = 10216032403722 || 10239764037898;
    const mainItemId = [10216032403722];
    const freeItemsIds = [51765839855882, 51765874884874, 51603901874442];

    console.log(mainItemId, 'mainItemId')

    const originalFetch = window.fetch;
    window.fetch = async (...args) => {
      const [resource] = args;
      const response = await originalFetch(...args);

      if (
        typeof resource === "string" &&
        (resource.includes("/cart/add") ||
          resource.includes("/cart/change") ||
          resource.includes("/cart/update"))
      ) {
        response.clone().json()
          .then(() => {
            document.dispatchEvent(new CustomEvent("cart:updated"));
          })
          .catch(() => {
            document.dispatchEvent(new CustomEvent("cart:updated"));
          });
      }

      return response;
    };

    const itemsToCheck = () => {
      fetch("/cart.js")
        .then((response) => response.json())
        .then((cart) => {
          const hasMainItem = cart.items.some( (item) => {
            if(mainItemId.includes(item.product_id)) {
              if ( item.selling_plan_allocation != null )return true;
              else return false;
            } else return false;
          });
          console.log(hasMainItem, 'hasMainItem')
          const freeItemsInCart = cart.items.filter((item) => freeItemsIds.includes(item.id));

          if (hasMainItem) {
            const updates = {};
            freeItemsIds.forEach((id) => {
              const freeItem = freeItemsInCart.find((item) => item.id === id);
              if (!freeItem || freeItem.quantity !== 1) {
                updates[id] = 1;
              }
            });

            if (Object.keys(updates).length > 0) {
              console.log("Normalizing free items to qty=1…");
              updateFreeItems(updates);
            }
          } else {
            if (freeItemsInCart.length > 0) {
              console.log("Main item missing, removing free items…");
              removeFreeItemsFromCart();
            }
          }
        })
        .catch((err) => console.error("Cart check error:", err));
    };

    const updateFreeItems = (updates) => {
      fetch("/cart/update.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({ updates }),
      })
        .then((res) => res.json())
        .then((data) => {
          console.log("Free items normalized:", data);
          refreshCartDrawer();
        })
        .catch((err) => console.error("Update free items error:", err));
    };

    const removeFreeItemsFromCart = () => {
      const updates = {};
      freeItemsIds.forEach((id) => (updates[id] = 0));

      fetch("/cart/update.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({ updates }),
      })
        .then((res) => res.json())
        .then((data) => {
          console.log("Free items removed:", data);
          refreshCartDrawer();
          itemsToCheck(); // re-verify after removal
        })
        .catch((err) => console.error("Remove free items error:", err));
    };

    const refreshCartDrawer = () => {
      fetch("/?section_id=cart-drawer")
        .then((res) => res.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, "text/html");
          const newDrawer = doc.querySelector("cart-drawer").querySelector('.drawer__inner');
          const cartDrawer = document.querySelector("cart-drawer").querySelector('.drawer__inner');
          const cartCount = doc.querySelector("cart-drawer-items").getAttribute('cart-count');
          if(cartCount == 0) document.querySelector('cart-drawer').classList.add('is-empty');
          if (cartDrawer && newDrawer) cartDrawer.replaceWith(newDrawer);
          document.querySelector('.cart-count-bubble').innerHTML = `<span aria-hidden="true">${cartCount}</span><span class="visually-hidden">${cartCount} items</span>`;
        })
        .catch((err) => console.error("Cart drawer refresh error:", err));
    };

    itemsToCheck();
    document.addEventListener("cart:updated", itemsToCheck);
    window.addEventListener("DOMContentLoaded", itemsToCheck);
  </script>
{% endif %}

