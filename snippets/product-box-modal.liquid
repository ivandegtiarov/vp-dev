<script defer>
  const singlePurchaseOption = document.querySelector('[data-single-purchase-option]');
  const multiPurchaseOption = document.querySelector('[data-multi-purchase-option]');

  singlePurchaseOption.addEventListener('click', () => {
    multiPurchaseOption.classList.remove('active');
    singlePurchaseOption.classList.add('active');
    document.querySelector('#appstle_selling_plan_label_10[name="selling_plan"]').click();
  });

  multiPurchaseOption.addEventListener('click', () => {
    singlePurchaseOption.classList.remove('active');
    multiPurchaseOption.classList.add('active');
    const value = document.querySelector('.product-box-modal-label-option-selector-options input:checked').value;
    document.querySelector('#appstle_selling_plan_label_20[name="selling_plan"]').click();
    document.querySelector('#appstle_selling_plan_label_20[name="selling_plan"]').value = value;
    document.querySelector('select#appstle_selling_plan0').value = value;
    document.querySelector('#appstle_subscription_widget0').setAttribute('data-selected-selling-plan', value);
  });


  if(window.location.href.includes('selling_plan')) {
    singlePurchaseOption.classList.remove('active');
    multiPurchaseOption.classList.add('active');
    const interval = setInterval(() => {
    const element = document.querySelector('select#appstle_selling_plan0');
      if (element) {
        const value = document.querySelector('select#appstle_selling_plan0').value;
        document.querySelector(`.product-box-modal-label-option-selector-options input[selling_value="${value}"]`).checked = true;
        console.log('value', value);
        clearInterval(interval);
      }
    }, 1000);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const func = (timer) => {
      setTimeout(() => {
        const element = document.querySelector('.product-box-modal-label-option:last-child')
        if (element) {
          element.click();
        }
      }, timer);
    }

    func(1000);
    func(2000);
  });

</script>